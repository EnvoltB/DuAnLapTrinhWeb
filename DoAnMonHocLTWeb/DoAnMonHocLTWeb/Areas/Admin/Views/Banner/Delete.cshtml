@model GearDTK.Models.Banners
@{
    ViewData["Title"] = "Xóa Banner";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Xóa Banner</h1>
        <a href="/Admin/Banner" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-triangle"></i>
                Bạn có chắc chắn muốn xóa Banner <strong>@Model.Title</strong>?
                Hành động này không thể hoàn tác!
            </div>

            <div class="row">
                <div class="col-md-4">
                    <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded" style="max-height: 200px;"
                         onerror="this.src='https://placehold.co/200x200/f5f5f5/999?text=No+Image'">
                </div>
                <div class="col-md-8">
                    <table class="table table-bordered">
                        <tr>
                            <th style="width: 150px">Tiêu đề</th>
                            <td>@Model.Title</td>
                        </tr>
                        <tr>
                            <th>Mô tả</th>
                            <td>@Model.Description</td>
                        </tr>
                        <tr>
                            <th>Liên kết</th>
                            <td><a href="@Model.LinkUrl" target="_blank">@Model.LinkUrl</a></td>
                        </tr>
                        <tr>
                            <th>Trạng thái</th>
                            <td>
                                <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                                    @(Model.IsActive ? "Hiển thị" : "Ẩn")
                                </span>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            <form asp-action="Delete" method="post" class="mt-3">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Xác nhận xóa
                </button>
                <a href="/Admin/Banner" class="btn btn-secondary">Hủy</a>
            </form>
        </div>
    </div>
</div>