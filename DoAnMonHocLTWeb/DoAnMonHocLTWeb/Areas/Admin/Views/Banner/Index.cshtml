@model IEnumerable<GearDTK.Models.Banners>
@{
    ViewData["Title"] = "Quản lý Banner";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2">Quản lý Banner</h1>
        <a href="/Admin/Banner/Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Thêm banner mới
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Hình ảnh</th>
                            <th>Liên kết</th>
                            <th>Thứ tự</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var banner in Model)
                        {
                            <tr>
                                <td>@banner.Id</td>
                                <td>
                                    <img src="@banner.ImageUrl" alt="Banner" style="width: 120px; height: 60px; object-fit: cover; border-radius: 4px;"
                                         onerror="this.src='https://placehold.co/120x60/f5f5f5/999?text=No+Image'">
                                </td>
                                <td>
                                    <a href="@banner.LinkUrl" target="_blank" class="text-truncate d-block" style="max-width: 200px;">
                                        @banner.LinkUrl
                                    </a>
                                </td>
                                <td>@banner.DisplayOrder</td>
                                <td>
                                    <span class="badge @(banner.IsActive ? "bg-success" : "bg-secondary")">
                                        @(banner.IsActive ? "Hiển thị" : "Ẩn")
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a href="/Admin/Banner/Edit/@banner.Id" class="btn btn-outline-primary">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button class="btn btn-outline-success" onclick="toggleStatus(@banner.Id)">
                                            <i class="fas @(banner.IsActive ? "fa-eye" : "fa-eye-slash")"></i>
                                        </button>
                                        <a href="/Admin/Banner/Delete/@banner.Id" class="btn btn-outline-danger">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4">
                                    <i class="fas fa-image fa-3x text-muted mb-3"></i>
                                    <h5>Chưa có banner nào</h5>
                                    <a href="/Admin/Banner/Create" class="btn btn-primary mt-2">Thêm banner đầu tiên</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleStatus(id) {
        $.ajax({
            url: '/Admin/Banner/ToggleStatus',
            type: 'POST',
            data: { id: id },
            success: function(response) {
                if (response.success) {
                    location.reload();
                } else {
                    alert(response.message);
                }
            },
            error: function() {
                alert('Có lỗi xảy ra!');
            }
        });
    }
</script>