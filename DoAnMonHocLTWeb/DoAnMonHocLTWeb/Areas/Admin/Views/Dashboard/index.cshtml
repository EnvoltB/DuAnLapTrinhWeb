@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Lấy dữ liệu từ ViewBag
    var productCount = ViewBag.ProductCount ?? 0;
    var categoryCount = ViewBag.CategoryCount ?? 0;
    var totalOrders = ViewBag.TotalOrders ?? 0;
    var userCount = ViewBag.UserCount ?? 0;

    // Lấy thời gian local (Việt Nam)
    var vietnamTime = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow,
        TimeZoneInfo.FindSystemTimeZoneById("SE Asia Standard Time"));
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2">Admin Dashboard</h1>
        <div>
            <span class="badge bg-primary p-2">Xin chào, @User.Identity?.Name</span>
        </div>
    </div>

    <!-- ========== THỐNG KÊ CHÍNH ========== -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Sản phẩm</h6>
                            <h2 class="display-4 mb-0">@productCount</h2>
                        </div>
                        <i class="fas fa-box fa-3x opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a href="/Admin/Product" class="text-white text-decoration-none">Quản lý →</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-success text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Danh mục</h6>
                            <h2 class="display-4 mb-0">@categoryCount</h2>
                        </div>
                        <i class="fas fa-tags fa-3x opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a href="/Admin/Category" class="text-white text-decoration-none">Quản lý →</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-warning text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Đơn hàng</h6>
                            <h2 class="display-4 mb-0">@totalOrders</h2>
                        </div>
                        <i class="fas fa-shopping-cart fa-3x opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a href="/Admin/Order" class="text-white text-decoration-none">Quản lý →</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-info text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Người dùng</h6>
                            <h2 class="display-4 mb-0">@userCount</h2>
                        </div>
                        <i class="fas fa-users fa-3x opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a href="/Admin/User" class="text-white text-decoration-none">Quản lý →</a>
                </div>
            </div>
        </div>
    </div>
    <!-- ========== MENU QUẢN LÝ NHANH ========== -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Quản lý nhanh</h5>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        <a href="/Admin/Product/Create" class="list-group-item list-group-item-action d-flex align-items-center">
                            <i class="fas fa-plus-circle text-success fa-lg me-3"></i>
                            <div>
                                <h6 class="mb-0">Thêm sản phẩm mới</h6>
                                <small class="text-muted">Tạo sản phẩm mới vào cửa hàng</small>
                            </div>
                            <i class="fas fa-chevron-right ms-auto"></i>
                        </a>
                        <a href="/Admin/Product" class="list-group-item list-group-item-action d-flex align-items-center">
                            <i class="fas fa-boxes text-primary fa-lg me-3"></i>
                            <div>
                                <h6 class="mb-0">Quản lý sản phẩm</h6>
                                <small class="text-muted">Sửa, xóa, xem danh sách sản phẩm</small>
                            </div>
                            <i class="fas fa-chevron-right ms-auto"></i>
                        </a>
                        <a href="/Admin/Category" class="list-group-item list-group-item-action d-flex align-items-center">
                            <i class="fas fa-tags text-warning fa-lg me-3"></i>
                            <div>
                                <h6 class="mb-0">Quản lý danh mục</h6>
                                <small class="text-muted">Thêm, sửa, xóa danh mục</small>
                            </div>
                            <i class="fas fa-chevron-right ms-auto"></i>
                        </a>
                        <a href="/Admin/Order" class="list-group-item list-group-item-action d-flex align-items-center">
                            <i class="fas fa-shopping-cart text-info fa-lg me-3"></i>
                            <div>
                                <h6 class="mb-0">Quản lý đơn hàng</h6>
                                <small class="text-muted">Xem, duyệt, cập nhật trạng thái đơn hàng</small>
                            </div>
                            <i class="fas fa-chevron-right ms-auto"></i>
                        </a>
                        <a href="/Admin/User" class="list-group-item list-group-item-action d-flex align-items-center">
                            <i class="fas fa-users text-danger fa-lg me-3"></i>
                            <div>
                                <h6 class="mb-0">Quản lý người dùng</h6>
                                <small class="text-muted">Thêm, sửa, xóa tài khoản và phân quyền</small>
                            </div>
                            <i class="fas fa-chevron-right ms-auto"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========== THÔNG TIN HỆ THỐNG ========== -->
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Thông tin hệ thống</h5>
                </div>
                <div class="card-body">
                    <table class="table table-sm">
                        <tr>
                            <td class="fw-bold">Phiên bản:</td>
                            <td>.NET 8.0</td>
                        </tr>
                        <tr>
                            <td class="fw-bold">Database:</td>
                            <td>SQL Server</td>
                        </tr>
                        <tr>
                            <td class="fw-bold">Thời gian:</td>
                            <td>@vietnamTime.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        </tr>
                        <tr>
                            <td class="fw-bold">Người dùng:</td>
                            <td>@User.Identity?.Name</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        
    </div>
</div>

@section Styles {
    <style>
        .card {
            border: none;
            box-shadow: 0 0 20px rgba(0,0,0,0.05);
            border-radius: 12px;
        }

        .card-header {
            background: white;
            border-bottom: 1px solid #eee;
            border-radius: 12px 12px 0 0 !important;
        }

        .list-group-item {
            border-left: none;
            border-right: none;
        }

            .list-group-item:first-child {
                border-top: none;
            }

            .list-group-item:last-child {
                border-bottom: none;
            }

        .card.bg-primary, .card.bg-success, .card.bg-warning, .card.bg-info {
            border-radius: 12px;
        }
    </style>
}