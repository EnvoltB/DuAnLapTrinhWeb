@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Lấy dữ liệu từ ViewBag
    var productCount = ViewBag.ProductCount ?? 0;
    var categoryCount = ViewBag.CategoryCount ?? 0;
    var totalOrders = ViewBag.TotalOrders ?? 0;
    var userCount = ViewBag.UserCount ?? 0;
    var BannerCount = ViewBag.BannerCount ?? 0;

    // Lấy thời gian local (Việt Nam)
    var vietnamTime = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow,
        TimeZoneInfo.FindSystemTimeZoneById("SE Asia Standard Time"));
}

<div class="container-fluid py-4">
    <!-- ========== HEADER ========== -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 fw-bold mb-1">Bảng điều khiển</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Trang chủ</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Admin</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex align-items-center mt-2 mt-md-0">
            <div class="d-flex align-items-center bg-white rounded-3 shadow-sm px-3 py-2">
                <div class="avatar-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width:38px;height:38px;font-weight:bold;">
                    @User.Identity?.Name?.Substring(0, 1).ToUpper()
                </div>
                <span class="fw-semibold text-dark">@User.Identity?.Name</span>
            </div>
        </div>
    </div>

    <!-- ========== THỐNG KÊ CHÍNH ========== -->
    <div class="row g-4 mb-4">
        <!-- Sản phẩm -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm stat-card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="card-body text-white d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase mb-2 opacity-75">Sản phẩm</h6>
                        <h2 class="display-6 fw-bold mb-0">@productCount</h2>
                    </div>
                    <i class="fas fa-box fa-3x opacity-50"></i>
                </div>
                <div class="card-footer bg-transparent border-0 pt-0">
                    <a href="/Admin/Product" class="text-white text-decoration-none stretched-link">
                        Quản lý <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
        <!-- Danh mục -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm stat-card" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                <div class="card-body text-white d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase mb-2 opacity-75">Danh mục</h6>
                        <h2 class="display-6 fw-bold mb-0">@categoryCount</h2>
                    </div>
                    <i class="fas fa-tags fa-3x opacity-50"></i>
                </div>
                <div class="card-footer bg-transparent border-0 pt-0">
                    <a href="/Admin/Category" class="text-white text-decoration-none stretched-link">
                        Quản lý <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
        <!-- Đơn hàng -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm stat-card" style="background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);">
                <div class="card-body d-flex justify-content-between align-items-center" style="color:#5a3e36;">
                    <div>
                        <h6 class="text-uppercase mb-2 opacity-75" style="color:#5a3e36;">Đơn hàng</h6>
                        <h2 class="display-6 fw-bold mb-0" style="color:#5a3e36;">@totalOrders</h2>
                    </div>
                    <i class="fas fa-shopping-cart fa-3x opacity-50" style="color:#5a3e36;"></i>
                </div>
                <div class="card-footer bg-transparent border-0 pt-0">
                    <a href="/Admin/Order" class="text-decoration-none stretched-link" style="color:#5a3e36;">
                        Quản lý <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
        <!-- Người dùng -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm stat-card" style="background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);">
                <div class="card-body d-flex justify-content-between align-items-center" style="color:#2d4059;">
                    <div>
                        <h6 class="text-uppercase mb-2 opacity-75" style="color:#2d4059;">Người dùng</h6>
                        <h2 class="display-6 fw-bold mb-0" style="color:#2d4059;">@userCount</h2>
                    </div>
                    <i class="fas fa-users fa-3x opacity-50" style="color:#2d4059;"></i>
                </div>
                <div class="card-footer bg-transparent border-0 pt-0">
                    <a href="/Admin/User" class="text-decoration-none stretched-link" style="color:#2d4059;">
                        Quản lý <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ========== MENU QUẢN LÝ NHANH ========== -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold">Quản lý nhanh</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <!-- Thêm sản phẩm mới -->
                        <div class="col-lg-4 col-md-6">
                            <a href="/Admin/Product/Create" class="text-decoration-none">
                                <div class="quick-link-card p-3 rounded-3 border bg-white h-100">
                                    <div class="d-flex align-items-start">
                                        <div class="icon-circle bg-success bg-opacity-10 text-success rounded-circle p-3 me-3">
                                            <i class="fas fa-plus-circle fa-lg"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-1">Thêm sản phẩm mới</h6>
                                            <small class="text-muted">Tạo sản phẩm mới vào cửa hàng</small>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <!-- Quản lý sản phẩm -->
                        <div class="col-lg-4 col-md-6">
                            <a href="/Admin/Product" class="text-decoration-none">
                                <div class="quick-link-card p-3 rounded-3 border bg-white h-100">
                                    <div class="d-flex align-items-start">
                                        <div class="icon-circle bg-primary bg-opacity-10 text-primary rounded-circle p-3 me-3">
                                            <i class="fas fa-boxes fa-lg"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-1">Quản lý sản phẩm</h6>
                                            <small class="text-muted">Sửa, xóa, xem danh sách sản phẩm</small>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <!-- Quản lý danh mục -->
                        <div class="col-lg-4 col-md-6">
                            <a href="/Admin/Category" class="text-decoration-none">
                                <div class="quick-link-card p-3 rounded-3 border bg-white h-100">
                                    <div class="d-flex align-items-start">
                                        <div class="icon-circle bg-warning bg-opacity-10 text-warning rounded-circle p-3 me-3">
                                            <i class="fas fa-tags fa-lg"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-1">Quản lý danh mục</h6>
                                            <small class="text-muted">Thêm, sửa, xóa danh mục</small>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <!-- Đơn hàng -->
                        <div class="col-lg-4 col-md-6">
                            <a href="/Admin/Order" class="text-decoration-none">
                                <div class="quick-link-card p-3 rounded-3 border bg-white h-100">
                                    <div class="d-flex align-items-start">
                                        <div class="icon-circle bg-info bg-opacity-10 text-info rounded-circle p-3 me-3">
                                            <i class="fas fa-shopping-cart fa-lg"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-1">Quản lý đơn hàng</h6>
                                            <small class="text-muted">Xem, duyệt, cập nhật trạng thái đơn hàng</small>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <!-- Banner -->
                        <div class="col-lg-4 col-md-6">
                            <a href="/Admin/Banner" class="text-decoration-none">
                                <div class="quick-link-card p-3 rounded-3 border bg-white h-100">
                                    <div class="d-flex align-items-start">
                                        <div class="icon-circle bg-danger bg-opacity-10 text-danger rounded-circle p-3 me-3">
                                            <i class="fas fa-image fa-lg"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-1">Quản lý Banner</h6>
                                            <small class="text-muted">Thêm, sửa, xóa Banner quảng cáo</small>
                                            <span class="badge bg-primary ms-2">@BannerCount</span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <!-- Doanh thu -->
                        <div class="col-lg-4 col-md-6">
                            <a href="/Admin/Revenue" class="text-decoration-none">
                                <div class="quick-link-card p-3 rounded-3 border bg-white h-100">
                                    <div class="d-flex align-items-start">
                                        <div class="icon-circle bg-success bg-opacity-10 text-success rounded-circle p-3 me-3">
                                            <i class="fas fa-chart-line fa-lg"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-1">Quản lý doanh thu</h6>
                                            <small class="text-muted">Xem thống kê và biểu đồ doanh thu</small>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <!-- Người dùng -->
                        <div class="col-lg-4 col-md-6">
                            <a href="/Admin/User" class="text-decoration-none">
                                <div class="quick-link-card p-3 rounded-3 border bg-white h-100">
                                    <div class="d-flex align-items-start">
                                        <div class="icon-circle bg-secondary bg-opacity-10 text-secondary rounded-circle p-3 me-3">
                                            <i class="fas fa-users fa-lg"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-1">Quản lý người dùng</h6>
                                            <small class="text-muted">Thêm, sửa, xóa tài khoản và phân quyền</small>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <!-- FAQ -->
                        <div class="col-lg-4 col-md-6">
                            <a href="/Admin/FAQ" class="text-decoration-none">
                                <div class="quick-link-card p-3 rounded-3 border bg-white h-100">
                                    <div class="d-flex align-items-start">
                                        <div class="icon-circle bg-dark bg-opacity-10 text-dark rounded-circle p-3 me-3">
                                            <i class="fas fa-question-circle fa-lg"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-1">Quản lý FAQ</h6>
                                            <small class="text-muted">Thêm, sửa, xóa câu hỏi thường gặp</small>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========== THÔNG TIN HỆ THỐNG & HOẠT ĐỘNG GẦN ĐÂY ========== -->
    <div class="row g-4">
        <!-- Thông tin hệ thống -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-server me-2 text-primary"></i>Thông tin hệ thống</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless table-sm mb-0">
                        <tr>
                            <td class="fw-semibold text-muted" width="40%">Phiên bản</td>
                            <td>.NET 8.0</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted">Database</td>
                            <td>SQL Server</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted">Thời gian hiện tại</td>
                            <td>@vietnamTime.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted">Người dùng đăng nhập</td>
                            <td><span class="badge bg-primary">@User.Identity?.Name</span></td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
        <!-- Hoạt động gần đây (placeholder) -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-history me-2 text-warning"></i>Hoạt động gần đây</h5>
                </div>
                <div class="card-body d-flex align-items-center justify-content-center text-muted">
                    <div class="text-center py-4">
                        <i class="fas fa-clipboard-list fa-3x mb-3 opacity-25"></i>
                        <p class="mb-0">Nhật ký hoạt động sẽ hiển thị tại đây</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <!-- Font Awesome (nếu chưa có) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        /* Hiệu ứng chung */
        body {
            background-color: #f4f6f9;
        }

        .stat-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border-radius: 16px;
            overflow: hidden;
        }

            .stat-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 12px 25px rgba(0,0,0,0.15) !important;
            }

            .stat-card .card-body {
                padding: 1.5rem 1.25rem 1rem;
            }

            .stat-card .card-footer a {
                font-weight: 500;
                font-size: 0.9rem;
            }

                .stat-card .card-footer a:hover {
                    text-decoration: underline !important;
                }

        .quick-link-card {
            transition: all 0.25s ease;
            cursor: pointer;
            border: 1px solid rgba(0,0,0,0.08);
        }

            .quick-link-card:hover {
                background-color: #f8f9fa;
                border-color: #dee2e6;
                transform: translateY(-3px);
                box-shadow: 0 6px 20px rgba(0,0,0,0.08);
            }

        .icon-circle {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 48px;
            height: 48px;
        }

        .breadcrumb {
            background: transparent;
            padding: 0;
            margin-bottom: 0;
        }

        .avatar-sm {
            font-size: 1rem;
            font-weight: 600;
        }

        /* Responsive adjustments */
        @@media (max-width: 768px) {
            .quick-link-card .d-flex {
                flex-direction: column;
                text-align: center;
            }

            .quick-link-card .icon-circle {
                margin-right: 0 !important;
                margin-bottom: 10px;
            }
        }
    </style>
}