@model GearDTK.Models.Product
@{
    ViewData["Title"] = "Sửa sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var categories = ViewBag.Categories as SelectList;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Sửa sản phẩm</h1>
        <a href="/Admin/Product" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />
                <input type="hidden" asp-for="MainImageUrl" id="oldMainImageUrl" />
                <input type="hidden" asp-for="GalleryImages" id="oldGalleryImages" />

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" id="productName" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Slug" class="form-label"></label>
                            <input asp-for="Slug" class="form-control" id="productSlug" />
                            <span asp-validation-for="Slug" class="text-danger"></span>
                            <small class="text-muted">Để trống để tự động tạo từ tên</small>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label"></label>
                            <select asp-for="CategoryId" asp-items="categories" class="form-select">
                                <option value="">-- Chọn danh mục --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Brand" class="form-label"></label>
                            <input asp-for="Brand" class="form-control" />
                            <span asp-validation-for="Brand" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="Price" class="form-label"></label>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="ComparePrice" class="form-label"></label>
                            <input asp-for="ComparePrice" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="ComparePrice" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="StockQuantity" class="form-label"></label>
                            <input asp-for="StockQuantity" class="form-control" type="number" />
                            <span asp-validation-for="StockQuantity" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ShortDescription" class="form-label"></label>
                    <textarea asp-for="ShortDescription" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="ShortDescription" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <!-- ========== UPLOAD HÌNH ẢNH CHÍNH (CÓ PREVIEW) ========== -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Hình ảnh hiện tại</label>
                    <div class="mb-2">
                        @if (!string.IsNullOrEmpty(Model.MainImageUrl))
                        {
                            <img src="@Model.MainImageUrl" alt="@Model.Name" style="max-height: 150px; border-radius: 8px;" class="img-thumbnail" id="currentMainImage" />
                        }
                        else
                        {
                            <p class="text-muted">Chưa có ảnh</p>
                        }
                    </div>

                    <label asp-for="MainImageFile" class="form-label">Chọn ảnh mới (để trống nếu giữ ảnh cũ)</label>
                    <input asp-for="MainImageFile" type="file" class="form-control" accept="image/*" id="mainImageInput" />
                    <span asp-validation-for="MainImageFile" class="text-danger"></span>
                    <div class="mt-2" id="mainImagePreview">
                        <img id="mainImagePreviewImg" src="#" alt="Preview" style="max-height: 150px; display: none; border-radius: 8px;" class="img-thumbnail" />
                    </div>
                    <small class="text-muted">Hỗ trợ: JPG, PNG, GIF, WEBP (tối đa 5MB). Để trống nếu không muốn thay đổi ảnh.</small>
                </div>

                <!-- ========== UPLOAD THƯ VIỆN ẢNH (CÓ PREVIEW) ========== -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Thư viện ảnh hiện tại</label>
                    <div class="mb-2 d-flex flex-wrap gap-2" id="currentGallery">
                        @if (!string.IsNullOrEmpty(Model.GalleryImages))
                        {
                            foreach (var img in Model.GalleryImages.Split(','))
                            {
                                if (!string.IsNullOrEmpty(img))
                                {
                                    <div class="gallery-item position-relative" style="width: 100px;">
                                        <img src="@img.Trim()" style="width: 100px; height: 100px; object-fit: cover; border-radius: 8px;" class="img-thumbnail" />
                                        <button type="button" class="btn btn-danger btn-sm remove-gallery-img position-absolute top-0 end-0" style="border-radius: 50%; width: 22px; height: 22px; padding: 0; font-size: 12px;" data-url="@img.Trim()">×</button>
                                    </div>
                                }
                            }
                        }
                        else
                        {
                            <p class="text-muted">Chưa có ảnh thư viện</p>
                        }
                    </div>

                    <label asp-for="GalleryFiles" class="form-label">Thêm ảnh mới (có thể chọn nhiều)</label>
                    <input asp-for="GalleryFiles" type="file" class="form-control" accept="image/*" multiple id="galleryInput" />
                    <span asp-validation-for="GalleryFiles" class="text-danger"></span>
                    <div class="mt-2" id="galleryPreview" style="display: flex; flex-wrap: wrap; gap: 10px;"></div>
                    <small class="text-muted">Hỗ trợ chọn nhiều ảnh cùng lúc (CTRL + Click). Ảnh mới sẽ được thêm vào thư viện.</small>
                </div>

                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="Weight" class="form-label"></label>
                            <input asp-for="Weight" class="form-control" type="number" />
                            <span asp-validation-for="Weight" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="Color" class="form-label"></label>
                            <input asp-for="Color" class="form-control" />
                            <span asp-validation-for="Color" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="Specifications" class="form-label"></label>
                            <input asp-for="Specifications" class="form-control" placeholder='{"key":"value"}' />
                            <span asp-validation-for="Specifications" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3 form-check">
                            <input asp-for="IsFeatured" class="form-check-input" />
                            <label asp-for="IsFeatured" class="form-check-label"></label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3 form-check">
                            <input asp-for="IsNew" class="form-check-input" />
                            <label asp-for="IsNew" class="form-check-label"></label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3 form-check">
                            <input asp-for="IsBestSeller" class="form-check-input" />
                            <label asp-for="IsBestSeller" class="form-check-label"></label>
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Lưu thay đổi
                    </button>
                    <a href="/Admin/Product" class="btn btn-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Preview ảnh chính mới
        $('#mainImageInput').change(function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    $('#mainImagePreviewImg').attr('src', e.target.result).show();
                    $('#currentMainImage').hide();
                };
                reader.readAsDataURL(file);
            } else {
                $('#mainImagePreviewImg').hide();
                $('#currentMainImage').show();
            }
        });

        // Preview ảnh gallery mới
        $('#galleryInput').change(function(e) {
            const files = e.target.files;
            const preview = $('#galleryPreview');
            preview.empty();

            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.append(`
                        <div class="gallery-thumb" style="position: relative; width: 100px;">
                            <img src="${e.target.result}" style="width: 100px; height: 100px; object-fit: cover; border-radius: 8px;" class="img-thumbnail" />
                            <span class="remove-new-gallery" style="position: absolute; top: -8px; right: -8px; background: red; color: white; border-radius: 50%; width: 20px; height: 20px; text-align: center; cursor: pointer; font-size: 12px;">×</span>
                        </div>
                    `);
                };
                reader.readAsDataURL(file);
            }
        });

        // Xóa ảnh gallery cũ (gửi AJAX)
        $('.remove-gallery-img').click(function() {
            const $btn = $(this);
            const imgUrl = $btn.data('url');
            const $item = $btn.closest('.gallery-item');

            $.ajax({
                url: '/Admin/Product/RemoveGalleryImage',
                type: 'POST',
                data: {
                    productId: '@Model.Id',
                    imageUrl: imgUrl
                },
                success: function(response) {
                    if (response.success) {
                        $item.remove();
                        if ($('#currentGallery .gallery-item').length === 0) {
                            $('#currentGallery').html('<p class="text-muted">Chưa có ảnh thư viện</p>');
                        }
                    }
                },
                error: function() {
                    alert('Có lỗi xảy ra khi xóa ảnh');
                }
            });
        });

        // Tự động tạo slug từ tên
        $('#productName').on('keyup', function() {
            var name = $(this).val();
            var slug = name.toLowerCase()
                .replace(/à|á|ạ|ả|ã|â|ầ|ấ|ậ|ẩ|ẫ|ă|ằ|ắ|ặ|ẳ|ẵ/g, 'a')
                .replace(/è|é|ẹ|ẻ|ẽ|ê|ề|ế|ệ|ể|ễ/g, 'e')
                .replace(/ì|í|ị|ỉ|ĩ/g, 'i')
                .replace(/ò|ó|ọ|ỏ|õ|ô|ồ|ố|ộ|ổ|ỗ|ơ|ờ|ớ|ợ|ở|ỡ/g, 'o')
                .replace(/ù|ú|ụ|ủ|ũ|ư|ừ|ứ|ự|ử|ữ/g, 'u')
                .replace(/ỳ|ý|ỵ|ỷ|ỹ/g, 'y')
                .replace(/đ/g, 'd')
                .replace(/\s+/g, '-')
                .replace(/[^a-z0-9-]/g, '');
            $('#productSlug').val(slug);
        });
    </script>
}