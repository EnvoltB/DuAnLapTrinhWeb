@model List<GearDTK.Models.Order>
@{
    ViewData["Title"] = "Lịch sử đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="order-history-container">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h2">Lịch sử đơn hàng</h1>
            <div>
                <a href="/Account/Profile" class="btn btn-outline-secondary me-2">
                    <i class="fas fa-user"></i> Hồ sơ
                </a>
                <a href="/ShoppingCart/Index" class="btn btn-outline-secondary">
                    <i class="fas fa-shopping-cart"></i> Giỏ hàng
                </a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="empty-state text-center py-5">
                <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
                <h3>Bạn chưa có đơn hàng nào</h3>
                <p>Hãy mua sắm và trải nghiệm sản phẩm của chúng tôi</p>
                <a href="/products" class="btn btn-primary mt-3">Mua sắm ngay</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table order-table">
                    <thead>
                        <tr>
                            <th>Mã đơn hàng</th>
                            <th>Ngày đặt</th>
                            <th>Số lượng</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            var itemCount = order.OrderItems != null ? order.OrderItems.Sum(x => x.Quantity) : 0;
                            var statusClass = order.OrderStatus switch
                            {
                                "Pending" => "warning",
                                "Processing" => "info",
                                "Shipped" => "primary",
                                "Delivered" => "success",
                                "Cancelled" => "danger",
                                _ => "secondary"
                            };
                            var statusText = order.OrderStatus switch
                            {
                                "Pending" => "Chờ xử lý",
                                "Processing" => "Đang xử lý",
                                "Shipped" => "Đang giao hàng",
                                "Delivered" => "Đã giao",
                                "Cancelled" => "Đã hủy",
                                _ => order.OrderStatus
                            };

                            <tr>
                                <td><span class="fw-bold">@order.OrderCode</span></td>
                                <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><span class="badge bg-secondary">@itemCount</span> sản phẩm</td>
                                <td><span class="fw-bold text-danger">@order.Total.ToString("N0")₫</span></td>
                                <td><span class="badge bg-@statusClass">@statusText</span></td>
                                <td>
                                    <a href="/Account/OrderDetail/@order.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye"></i> Chi tiết
                                    </a>
                                    @if (order.OrderStatus == "Pending" || order.OrderStatus == "Processing")
                                    {
                                        <button class="btn btn-sm btn-outline-danger ms-1" onclick="cancelOrder(@order.Id)">
                                            <i class="fas fa-times"></i> Hủy
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<style>
    .order-history-container {
        background: #ffffff;
        min-height: 100vh;
    }

    .order-table {
        border: 1px solid #e5e5e5;
        border-radius: 12px;
        width: 100%;
    }

        .order-table th {
            background: #f8f9fa;
            padding: 1rem;
            font-weight: 600;
        }

        .order-table td {
            padding: 1rem;
            vertical-align: middle;
        }

    .badge {
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 0.75rem;
    }

    .bg-warning {
        background: #ffc107;
        color: #856404;
    }

    .bg-info {
        background: #17a2b8;
        color: white;
    }

    .bg-primary {
        background: #007bff;
        color: white;
    }

    .bg-success {
        background: #28a745;
        color: white;
    }

    .bg-danger {
        background: #dc3545;
        color: white;
    }

    .bg-secondary {
        background: #6c757d;
        color: white;
    }

    .empty-state {
        background: #f8f9fa;
        border-radius: 16px;
    }

    @@media (max-width: 768px) {
        .order-table {
            font-size: 0.8rem;
        }

            .order-table th, .order-table td {
                padding: 0.75rem 0.5rem;
            }
    }
</style>

@section Scripts {
    <script>
        function cancelOrder(orderId) {
            if (confirm('Bạn có chắc chắn muốn hủy đơn hàng này?')) {
                $.ajax({
                    url: '/Account/CancelOrder',
                    type: 'POST',
                    data: { id: orderId },
                    success: function(response) {
                        if (response.success) {
                            alert('Đã hủy đơn hàng thành công!');
                            location.reload();
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function() {
                        alert('Có lỗi xảy ra, vui lòng thử lại!');
                    }
                });
            }
        }
    </script>
}