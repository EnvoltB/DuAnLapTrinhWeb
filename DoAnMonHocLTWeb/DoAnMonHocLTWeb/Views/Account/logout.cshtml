@{
    ViewData["Title"] = "Đăng xuất";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-danger text-white text-center py-3">
                    <h4 class="mb-0"><i class="fas fa-sign-out-alt"></i> Đăng xuất</h4>
                </div>
                <div class="card-body p-4 text-center">
                    <div class="mb-4">
                        <i class="fas fa-question-circle fa-4x text-warning mb-3"></i>
                        <h5 class="mb-3">Bạn có chắc chắn muốn đăng xuất?</h5>
                        <p class="text-muted">
                            Bạn sẽ cần đăng nhập lại để truy cập vào tài khoản của mình.
                        </p>
                    </div>

                    <div class="d-flex justify-content-center gap-3">
                        <form asp-action="LogoutConfirmed" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-lg px-4">
                                <i class="fas fa-sign-out-alt"></i> Đăng xuất
                            </button>
                        </form>
                        <a href="/" class="btn btn-secondary btn-lg px-4">
                            <i class="fas fa-home"></i> Về trang chủ
                        </a>
                    </div>
                </div>
            </div>
        </div>
</div>

<style>
    .card {
        border-radius: 16px;
        overflow: hidden;
    }

    .btn {
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .btn:hover {
            transform: translateY(-2px);
        }
</style>