@model IEnumerable<GearDTK.Models.Category>
@{
    ViewData["Title"] = "Danh mục sản phẩm - GearDTK";
}

<div class="container py-4">
    <!-- Page Header -->
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold mb-3">Danh mục sản phẩm</h1>
        <p class="lead text-muted">Khám phá các dòng sản phẩm gaming gear cao cấp của chúng tôi</p>
    </div>

    <!-- Categories Grid -->
    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <i class="fas fa-folder-open fa-3x mb-3"></i>
            <h4>Chưa có danh mục nào</h4>
            <p>Danh mục sẽ được cập nhật sớm!</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var category in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <a href="/products/category/@category.Slug" class="text-decoration-none">
                        <div class="category-card h-100">
                            <div class="category-card-inner">
                                <div class="category-icon">
                                    <i class="@category.IconClass"></i>
                                </div>
                                <h3 class="category-name">@category.Name</h3>
                                <p class="category-description">@category.Description</p>
                                <div class="category-stats">
                                    <span class="product-count">
                                        <i class="fas fa-box"></i> @(category.Products?.Count ?? 0) sản phẩm
                                    </span>
                                    <span class="shop-now">
                                        Xem ngay <i class="fas fa-arrow-right"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }

    <!-- Features Section -->
    <div class="features-section mt-5 pt-4">
        <div class="row g-4">
            <div class="col-md-3 col-6">
                <div class="feature-item text-center">
                    <i class="fas fa-truck fa-2x text-primary mb-2"></i>
                    <h6>Free Shipping</h6>
                    <small class="text-muted">Cho đơn hàng > 1.000.000đ</small>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="feature-item text-center">
                    <i class="fas fa-shield-alt fa-2x text-primary mb-2"></i>
                    <h6>Bảo hành 12 tháng</h6>
                    <small class="text-muted">Chính hãng 100%</small>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="feature-item text-center">
                    <i class="fas fa-undo-alt fa-2x text-primary mb-2"></i>
                    <h6>Đổi trả 7 ngày</h6>
                    <small class="text-muted">Hỗ trợ đổi trả</small>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="feature-item text-center">
                    <i class="fas fa-headset fa-2x text-primary mb-2"></i>
                    <h6>Hỗ trợ 24/7</h6>
                    <small class="text-muted">Chăm sóc khách hàng</small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .category-card {
            background: white;
            border-radius: 20px;
            padding: 2rem 1.5rem;
            text-align: center;
            transition: all 0.3s ease;
            box-shadow: 0 5px 20px rgba(0,0,0,0.05);
            height: 100%;
            border: 1px solid #eee;
        }

            .category-card:hover {
                transform: translateY(-10px);
                box-shadow: 0 20px 40px rgba(102, 126, 234, 0.15);
                border-color: #667eea;
            }

        .category-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            transition: all 0.3s ease;
        }

            .category-icon i {
                font-size: 2.5rem;
                color: white;
            }

        .category-card:hover .category-icon {
            transform: scale(1.05);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.3);
        }

        .category-name {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 0.75rem;
        }

        .category-description {
            color: #666;
            font-size: 0.9rem;
            line-height: 1.5;
            margin-bottom: 1.5rem;
        }

        .category-stats {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 1rem;
            border-top: 1px solid #eee;
        }

        .product-count {
            color: #667eea;
            font-size: 0.85rem;
            font-weight: 500;
        }

            .product-count i {
                margin-right: 0.25rem;
            }

        .shop-now {
            color: #667eea;
            font-size: 0.85rem;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .category-card:hover .shop-now {
            transform: translateX(5px);
        }

        .shop-now i {
            font-size: 0.75rem;
            transition: transform 0.3s ease;
        }

        .category-card:hover .shop-now i {
            transform: translateX(3px);
        }

        /* Features Section */
        .features-section {
            background: #f8f9fa;
            border-radius: 20px;
            padding: 2rem;
        }

        .feature-item {
            padding: 1rem;
            transition: all 0.3s ease;
            border-radius: 12px;
        }

            .feature-item:hover {
                background: white;
                box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            }

            .feature-item i {
                transition: transform 0.3s ease;
            }

            .feature-item:hover i {
                transform: scale(1.1);
            }

            .feature-item h6 {
                font-weight: 600;
                margin-bottom: 0.25rem;
                color: #1a1a1a;
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .category-name {
                font-size: 1.2rem;
            }

            .category-icon {
                width: 60px;
                height: 60px;
            }

                .category-icon i {
                    font-size: 1.8rem;
                }

            .category-description {
                font-size: 0.8rem;
            }

            .features-section {
                padding: 1.5rem;
            }

            .feature-item h6 {
                font-size: 0.8rem;
            }

            .feature-item small {
                font-size: 0.7rem;
            }
        }

        @@media (max-width: 576px) {
            .category-card {
                padding: 1.5rem 1rem;
            }

            .category-stats {
                flex-direction: column;
                gap: 0.75rem;
            }

            .shop-now {
                width: 100%;
                text-align: center;
            }
        }
    </style>
}