@using GearDTK.Controllers
@model PaginatedList<GearDTK.Models.Product>
@{
    var category = ViewBag.Category as GearDTK.Models.Category;
    ViewData["Title"] = category?.Name + " - GearDTK";
}

<div class="category-container">
    <div class="container py-4">
        <!-- Breadcrumb -->
        <div class="breadcrumb-wrapper mb-4">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item"><a href="/products">All products</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@category?.Name</li>
                </ol>
            </nav>
        </div>

        <!-- Category Header -->
        <div class="category-header text-center mb-5">
            <div class="category-icon mb-3">
                <i class="@category?.IconClass fa-3x"></i>
            </div>
            <h1 class="display-5 fw-bold">@category?.Name</h1>
            <p class="lead text-muted">@category?.Description</p>
        </div>

        <!-- Sort Bar -->
        <div class="sort-bar mb-4">
            <div class="results-count">
                <span>Hiển thị <strong>@Model.Count</strong> / <strong>@Model.TotalPages</strong> sản phẩm</span>
            </div>
            <div class="sort-options">
                <label class="me-2">Sort by:</label>
                <select id="sortSelect" class="sort-select">
                    <option value="name_asc">Alphabetically, A-Z</option>
                    <option value="name_desc">Alphabetically, Z-A</option>
                    <option value="price_asc">Price, low to high</option>
                    <option value="price_desc">Price, high to low</option>
                    <option value="newest">Newest first</option>
                </select>
            </div>
        </div>

        <!-- Products Grid -->
        @if (!Model.Any())
        {
            <div class="empty-state text-center py-5">
                <i class="fas fa-box-open fa-4x mb-3 text-muted"></i>
                <h4>No products found</h4>
                <p class="text-muted">There are no products in this category yet.</p>
                <a href="/products" class="btn btn-dark mt-3">Browse all products</a>
            </div>
        }
        else
        {
            <div class="products-grid" id="productsGrid">
                @foreach (var product in Model)
                {
                    <div class="product-card"
                         data-name="@product.Name"
                         data-price="@product.Price"
                         data-date="@product.CreatedAt.Ticks">
                        <div class="product-badges">
                            @if (product.DiscountPercent.HasValue)
                            {
                                <span class="badge-sale">-@product.DiscountPercent%</span>
                            }
                            @if (product.IsNew)
                            {
                                <span class="badge-new">New</span>
                            }
                            @if (product.IsBestSeller)
                            {
                                <span class="badge-bestseller">Best Seller</span>
                            }
                        </div>
                        <div class="product-image">
                            <a href="/products/details/@product.Slug">
                                <img src="@product.MainImageUrl" alt="@product.Name"
                                     onerror="this.src='https://placehold.co/300x300/f5f5f5/999?text=No+Image'">
                            </a>
                        </div>
                        <div class="product-info">
                            <h3 class="product-title">
                                <a href="/products/details/@product.Slug">@product.Name</a>
                            </h3>
                            <div class="product-price">
                                <span class="current-price">@product.Price.ToString("N0") VND</span>
                                @if (product.ComparePrice.HasValue)
                                {
                                    <span class="old-price">@product.ComparePrice.Value.ToString("N0") VND</span>
                                }
                            </div>
                            <div class="product-rating">
                                <div class="stars">
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star-half-alt"></i>
                                </div>
                                <span class="rating-count">(128 reviews)</span>
                            </div>
                            @if (product.StockQuantity > 0)
                            {
                                <button class="btn-add-cart" data-id="@product.Id">
                                    <i class="fas fa-shopping-cart"></i> Add to cart
                                </button>
                            }
                            else
                            {
                                <button class="btn-sold-out" disabled>
                                    <i class="fas fa-times"></i> Sold Out
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
            var nextDisabled = !Model.HasNextPage ? "disabled" : "";

            <nav class="pagination-wrapper mt-5">
                <ul class="pagination justify-content-center">
                    <li class="page-item @prevDisabled">
                        <a class="page-link" asp-action="Category" asp-route-slug="@category?.Slug" asp-route-pageNumber="@(Model.PageIndex - 1)">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    </li>

                    @{
                        int start = Math.Max(1, Model.PageIndex - 2);
                        int end = Math.Min(Model.TotalPages, Model.PageIndex + 2);

                        if (start > 1)
                        {
                            <li class="page-item"><a class="page-link" asp-action="Category" asp-route-slug="@category?.Slug" asp-route-pageNumber="1">1</a></li>
                            if (start > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }

                        for (int i = start; i <= end; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" asp-action="Category" asp-route-slug="@category?.Slug" asp-route-pageNumber="@i">@i</a>
                            </li>
                        }

                        if (end < Model.TotalPages)
                        {
                            if (end < Model.TotalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            <li class="page-item"><a class="page-link" asp-action="Category" asp-route-slug="@category?.Slug" asp-route-pageNumber="@Model.TotalPages">@Model.TotalPages</a></li>
                        }
                    }

                    <li class="page-item @nextDisabled">
                        <a class="page-link" asp-action="Category" asp-route-slug="@category?.Slug" asp-route-pageNumber="@(Model.PageIndex + 1)">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Sort functionality
        $('#sortSelect').change(function() {
            var sortBy = $(this).val();
            var $grid = $('#productsGrid');
            var $cards = $grid.children('.product-card').get();

            $cards.sort(function(a, b) {
                var $a = $(a);
                var $b = $(b);

                switch(sortBy) {
                    case 'name_asc':
                        return $a.data('name').localeCompare($b.data('name'));
                    case 'name_desc':
                        return $b.data('name').localeCompare($a.data('name'));
                    case 'price_asc':
                        return $a.data('price') - $b.data('price');
                    case 'price_desc':
                        return $b.data('price') - $a.data('price');
                    case 'newest':
                        return $b.data('date') - $a.data('date');
                    default:
                        return 0;
                }
            });

            $.each($cards, function(idx, card) {
                $grid.append(card);
            });
        });

        // Add to cart
        $('.btn-add-cart').click(function() {
            var $btn = $(this);
            var productId = $btn.data('id');
            var originalText = $btn.html();

            $btn.html('<i class="fas fa-spinner fa-spin"></i> Adding...');
            $btn.prop('disabled', true);

            setTimeout(function() {
                $btn.html('<i class="fas fa-check"></i> Added!');
                setTimeout(function() {
                    $btn.html(originalText);
                    $btn.prop('disabled', false);
                }, 2000);
            }, 500);
        });
    </script>
}

@section Styles {
    <style>
        .category-container {
            background: #ffffff;
            min-height: 100vh;
        }

        .breadcrumb-wrapper {
            border-bottom: 1px solid #e5e5e5;
            padding-bottom: 1rem;
        }

        .breadcrumb {
            background: transparent;
            padding: 0;
            margin: 0;
        }

        .breadcrumb-item a {
            color: #666;
            text-decoration: none;
        }

        .breadcrumb-item.active {
            color: #000;
            font-weight: 500;
        }

        .category-icon i {
            color: #667eea;
        }

        .sort-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 1rem;
            border-bottom: 1px solid #e5e5e5;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .results-count {
            color: #666;
            font-size: 14px;
        }

        .sort-select {
            padding: 6px 12px;
            border: 1px solid #ddd;
            border-radius: 4px;
            background: white;
            cursor: pointer;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
        }

        .product-card {
            transition: transform 0.2s ease;
        }

            .product-card:hover {
                transform: translateY(-4px);
            }

        .product-badges {
            position: absolute;
            top: 12px;
            left: 12px;
            z-index: 2;
            display: flex;
            gap: 0.5rem;
        }

        .badge-sale {
            background: #ff4444;
            color: white;
            padding: 4px 8px;
            font-size: 11px;
            font-weight: 500;
        }

        .badge-new {
            background: #00a650;
            color: white;
            padding: 4px 8px;
            font-size: 11px;
            font-weight: 500;
        }

        .badge-bestseller {
            background: #ff9800;
            color: white;
            padding: 4px 8px;
            font-size: 11px;
            font-weight: 500;
        }

        .product-image {
            background: #f8f8f8;
            border-radius: 12px;
            overflow: hidden;
            aspect-ratio: 1 / 1;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .product-image img {
                max-width: 100%;
                max-height: 100%;
                object-fit: contain;
                padding: 1.5rem;
                transition: transform 0.3s;
            }

        .product-card:hover .product-image img {
            transform: scale(1.05);
        }

        .product-title {
            font-size: 1rem;
            font-weight: 500;
            margin: 0.75rem 0 0.5rem;
        }

            .product-title a {
                color: #000;
                text-decoration: none;
            }

                .product-title a:hover {
                    text-decoration: underline;
                }

        .current-price {
            font-size: 1rem;
            font-weight: 600;
            color: #000;
        }

        .old-price {
            font-size: 0.8rem;
            color: #999;
            text-decoration: line-through;
            margin-left: 0.5rem;
        }

        .product-rating {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin: 0.5rem 0;
        }

        .stars {
            display: flex;
            gap: 2px;
        }

            .stars i {
                font-size: 11px;
                color: #ffc107;
            }

        .rating-count {
            font-size: 11px;
            color: #666;
        }

        .btn-add-cart {
            width: 100%;
            background: #000;
            border: none;
            border-radius: 8px;
            padding: 10px;
            color: white;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.2s;
        }

            .btn-add-cart:hover {
                background: #333;
            }

        .btn-sold-out {
            width: 100%;
            background: #f0f0f0;
            border: none;
            border-radius: 8px;
            padding: 10px;
            color: #999;
            font-size: 13px;
            cursor: not-allowed;
        }

        .pagination {
            gap: 0.5rem;
        }

        .page-item .page-link {
            background: transparent;
            border: none;
            color: #000;
            padding: 6px 12px;
            border-radius: 4px;
        }

        .page-item.active .page-link {
            background: #000;
            color: white;
        }

        .page-item.disabled .page-link {
            color: #ccc;
        }

        @@media (max-width: 768px) {
            .products-grid {
                grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
                gap: 1rem;
            }

            .sort-bar {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
}