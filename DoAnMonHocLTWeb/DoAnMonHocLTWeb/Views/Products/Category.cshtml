@using GearDTK.Controllers
@using GearDTK.Models
@using static GearDTK.Controllers.ProductsController
@model PaginatedList<GearDTK.Models.Product>
@{
    var category = ViewBag.Category as GearDTK.Models.Category;
    ViewData["Title"] = category?.Name + " - GearDTK";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/products">Sản phẩm</a></li>
            <li class="breadcrumb-item active">@category?.Name</li>
        </ol>
    </nav>

    <!-- Category Header -->
    <div class="category-header mb-4 text-center">
        <div class="category-icon mb-3">
            <i class="@category?.IconClass fa-3x"></i>
        </div>
        <h1 class="display-5 fw-bold">@category?.Name</h1>
        <p class="lead text-muted">@category?.Description</p>
    </div>

    <!-- Sort Options -->
    <div class="row mb-4">
        <div class="col-md-12 text-end">
            <div class="btn-group">
                <a asp-action="Category" asp-route-slug="@category?.Slug" asp-route-sortOrder="name_asc" 
                   class="btn btn-outline-secondary">Tên A-Z</a>
                <a asp-action="Category" asp-route-slug="@category?.Slug" asp-route-sortOrder="name_desc" 
                   class="btn btn-outline-secondary">Tên Z-A</a>
                <a asp-action="Category" asp-route-slug="@category?.Slug" asp-route-sortOrder="price_asc" 
                   class="btn btn-outline-secondary">Giá tăng dần</a>
                <a asp-action="Category" asp-route-slug="@category?.Slug" asp-route-sortOrder="price_desc" 
                   class="btn btn-outline-secondary">Giá giảm dần</a>
            </div>
        </div>
    </div>

    <!-- Products Grid -->
    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <i class="fas fa-box-open fa-3x mb-3"></i>
            <h4>Chưa có sản phẩm nào trong danh mục này</h4>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var product in Model)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="product-card h-100">
                        <div class="position-relative">
                            @if (product.DiscountPercent.HasValue)
                            {
                                <span class="badge-discount">-@product.DiscountPercent%</span>
                            }
                            @if (product.IsNew)
                            {
                                <span class="badge bg-success position-absolute top-0 start-0 m-2">New</span>
                            }
                            <a href="/products/details/@product.Slug">
                                <img src="@product.MainImageUrl" class="card-img-top" alt="@product.Name"
                                     onerror="this.src='https://placehold.co/400x400/f5f5f5/999?text=No+Image'">
                            </a>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">
                                <a href="/products/details/@product.Slug" class="text-decoration-none text-dark">@product.Name</a>
                            </h5>
                            <div class="product-price">
                                <span class="current-price">@product.Price.ToString("N0")₫</span>
                                @if (product.ComparePrice.HasValue)
                                {
                                    <span class="old-price">@product.ComparePrice.Value.ToString("N0")₫</span>
                                }
                            </div>
                            <div class="product-rating mt-2">
                                <div class="stars">
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star-half-alt"></i>
                                </div>
                                <span class="rating-count">(128 reviews)</span>
                            </div>
                            @if (product.StockQuantity > 0)
                            {
                                <button class="btn-add-cart w-100 mt-3" data-id="@product.Id" data-stock="@product.StockQuantity">
                                    <i class="fas fa-shopping-cart"></i> Add to cart
                                </button>
                            }
                            else
                            {
                                <button class="btn-add-cart w-100 mt-3 disabled" disabled>
                                    <i class="fas fa-times"></i> Sold Out
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
        var nextDisabled = !Model.HasNextPage ? "disabled" : "";
        
        <nav class="mt-5">
            <ul class="pagination justify-content-center">
                <li class="page-item @prevDisabled">
                    <a class="page-link" asp-action="Category" asp-route-slug="@category?.Slug" asp-route-pageNumber="@(Model.PageIndex - 1)">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Category" asp-route-slug="@category?.Slug" asp-route-pageNumber="@i">@i</a>
                    </li>
                }
                <li class="page-item @nextDisabled">
                    <a class="page-link" asp-action="Category" asp-route-slug="@category?.Slug" asp-route-pageNumber="@(Model.PageIndex + 1)">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts {
    <script>
        // Add to cart functionality for category page
        $(document).ready(function() {
            $('.btn-add-cart:not(.disabled)').off('click').on('click', function(e) {
                e.preventDefault();
                
                var $btn = $(this);
                var productId = $btn.data('id');
                var stock = $btn.data('stock');
                var originalText = $btn.html();
                
                console.log("Add to cart clicked - Product ID:", productId, "Stock:", stock);
                
                // Check stock
                if (stock <= 0) {
                    alert('Sản phẩm đã hết hàng!');
                    return;
                }
                
                // Disable button and show loading
                $btn.html('<i class="fas fa-spinner fa-spin"></i> Adding...');
                $btn.prop('disabled', true);
                
                $.ajax({
                    url: '/cart/add',
                    type: 'POST',
                    data: { productId: productId, quantity: 1 },
                    success: function(response) {
                        console.log("AJAX Success:", response);
                        if (response.success) {
                            // Update cart count
                            $('#cartCount').text(response.cartCount);
                            $('#cartCount').show();
                            
                            // Show success state
                            $btn.html('<i class="fas fa-check"></i> Added!');
                            setTimeout(function() {
                                $btn.html(originalText);
                                $btn.prop('disabled', false);
                            }, 2000);
                        } else {
                            // Show error
                            $btn.html(originalText);
                            $btn.prop('disabled', false);
                            alert(response.message || 'Có lỗi xảy ra!');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error("AJAX Error:", error);
                        console.error("Status:", status);
                        console.error("Response:", xhr.responseText);
                        $btn.html(originalText);
                        $btn.prop('disabled', false);
                        alert('Có lỗi xảy ra, vui lòng thử lại!');
                    }
                });
            });
        });
    </script>
}

@section Styles {
    <style>
        .product-card {
            border: 1px solid #eee;
            border-radius: 12px;
            overflow: hidden;
            transition: all 0.3s;
            background: white;
        }
        
        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }
        
        .product-card img {
            padding: 1rem;
            background: #f8f9fa;
            width: 100%;
            height: 200px;
            object-fit: contain;
        }
        
        .badge-discount {
            position: absolute;
            top: 10px;
            right: 10px;
            background: #ff4444;
            color: white;
            padding: 4px 8px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: bold;
            z-index: 1;
        }
        
        .current-price {
            font-size: 1.1rem;
            font-weight: bold;
            color: #667eea;
        }
        
        .old-price {
            font-size: 0.8rem;
            color: #999;
            text-decoration: line-through;
            margin-left: 0.5rem;
        }
        
        .product-rating .stars {
            display: inline-flex;
            gap: 2px;
        }
        
        .product-rating .stars i {
            font-size: 11px;
            color: #ffc107;
        }
        
        .rating-count {
            font-size: 11px;
            color: #666;
            margin-left: 0.5rem;
        }
        
        .btn-add-cart {
            background: #1a1a1a;
            border: none;
            border-radius: 8px;
            padding: 10px;
            color: white;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
        }
        
        .btn-add-cart:hover:not(.disabled) {
            background: #333;
        }
        
        .btn-add-cart.disabled {
            background: #f0f0f0;
            color: #999;
            cursor: not-allowed;
        }
        
        .pagination .page-link {
            color: #667eea;
        }
        
        .pagination .active .page-link {
            background-color: #667eea;
            border-color: #667eea;
            color: white;
        }
        
        @@media (max-width: 768px) {
            .product-card img {
                height: 150px;
            }
        }
    </style>
}