@model GearDTK.Models.Product
@{
    ViewData["Title"] = Model != null ? Model.Name + " - GearDTK" : "Sản phẩm không tồn tại";
    var relatedProducts = ViewBag.RelatedProducts as List<GearDTK.Models.Product>;
}

@if (Model == null)
{
    <div class="container py-5 text-center">
        <i class="fas fa-box-open fa-4x mb-3 text-muted"></i>
        <h2>Không tìm thấy sản phẩm</h2>
        <p>Sản phẩm bạn đang tìm kiếm không tồn tại hoặc đã bị xóa.</p>
        <a href="/products" class="btn btn-dark">Quay lại cửa hàng</a>
    </div>
}
else
{
    <div class="product-detail-container">
        <div class="container">
            <!-- Breadcrumb -->
            <div class="breadcrumb-wrapper py-3">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                        <li class="breadcrumb-item"><a href="/products">All products</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
                    </ol>
                </nav>
            </div>

            <div class="row g-5">
                <!-- Product Gallery - Left Column -->
                <div class="col-lg-6">
                    <div class="product-gallery">
                        <!-- Main Image -->
                        <div class="main-image-wrapper">
                            <img id="mainProductImage" src="@Model.MainImageUrl" alt="@Model.Name" class="main-product-image"
                                 onerror="this.src='https://placehold.co/600x600/f5f5f5/999?text=No+Image'">
                        </div>

                        <!-- Thumbnail Gallery -->
                        @if (Model.GalleryImagesList != null && Model.GalleryImagesList.Length > 0)
                        {
                            <div class="thumbnail-wrapper">
                                @foreach (var img in Model.GalleryImagesList)
                                {
                                    if (!string.IsNullOrEmpty(img))
                                    {
                                        <div class="thumbnail-item" data-image="@img.Trim()">
                                            <img src="@img.Trim()" alt="Thumbnail"
                                                 onerror="this.src='https://placehold.co/100x100/f5f5f5/999?text=No+Image'">
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Product Info - Right Column -->
                <div class="col-lg-6">
                    <div class="product-info">
                        <!-- Stock Badge -->
                        <div class="stock-badge">
                            @if (Model.StockQuantity > 0)
                            {
                                <span class="in-stock"><i class="fas fa-check-circle"></i> In stock</span>
                            }
                            else
                            {
                                <span class="out-of-stock"><i class="fas fa-times-circle"></i> Sold Out</span>
                            }
                        </div>

                        <!-- Product Title -->
                        <h1 class="product-title">@Model.Name</h1>

                        <!-- Price -->
                        <div class="product-price">
                            @if (Model.ComparePrice.HasValue && Model.ComparePrice > Model.Price)
                            {
                                <span class="current-price">@Model.Price.ToString("N0") VND</span>
                                <span class="old-price">@Model.ComparePrice.Value.ToString("N0") VND</span>
                                <span class="save-price">Save @((Model.ComparePrice.Value - Model.Price).ToString("N0")) VND</span>
                            }
                            else
                            {
                                <span class="current-price">@Model.Price.ToString("N0") VND</span>
                            }
                        </div>

                        <!-- Rating -->
                        <div class="product-rating">

                            <div class="stars">

                                @{
                                    double avgRating = ViewBag.AverageRating ?? 0;
                                }

                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Floor(avgRating))
                                    {
                                        <i class="fas fa-star text-warning"></i>
                                    }
                                    else if (i - avgRating < 1)
                                    {
                                        <i class="fas fa-star-half-alt text-warning"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-star text-warning"></i>
                                    }
                                }

                            </div>

                            <span class="rating-count">

                                @avgRating.ToString("0.0")
                                (@ViewBag.TotalReviews reviews)

                            </span>

                        </div>

                        <!-- Short Description -->
                        <div class="product-short-desc">
                            <p>@Model.ShortDescription</p>
                        </div>

                        <!-- Specifications List -->
                        <div class="specs-list">
                            @if (!string.IsNullOrEmpty(Model.Specifications))
                            {
                                try
                                {
                                    var specs = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(Model.Specifications);
                                    if (specs != null && specs.Any())
                                    {
                                        foreach (var spec in specs.Take(6))
                                        {
                                            <div class="spec-item">
                                                <span class="spec-label">@spec.Key:</span>
                                                <span class="spec-value">@spec.Value</span>
                                            </div>
                                        }
                                    }
                                }
                                catch
                                {
                                    <div class="spec-item">
                                        <span class="spec-value">@Model.Specifications</span>
                                    </div>
                                }
                            }
                        </div>

                        <!-- Color Option (if available) -->
                        @if (!string.IsNullOrEmpty(Model.Color))
                        {
                            <div class="product-option">
                                <div class="option-label">Color:</div>
                                <div class="color-options">
                                    <span class="color-tag active">@Model.Color</span>
                                </div>
                            </div>
                        }

                        <!-- Add to Cart Section -->
                        @if (Model.StockQuantity > 0)
                        {
                            <div class="add-to-cart-section">
                                <div class="quantity-selector">
                                    <button class="qty-btn" id="qtyMinus">-</button>
                                    <input type="number" id="quantity" class="qty-input" value="1" min="1" max="@Model.StockQuantity">
                                    <button class="qty-btn" id="qtyPlus">+</button>
                                </div>
                                <button id="addToCartBtn" class="btn-add-cart" data-product-id="@Model.Id" data-stock="@Model.StockQuantity">
                                    <i class="fas fa-shopping-cart"></i> Add to cart
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="sold-out-section">
                                <button class="btn-sold-out" disabled>
                                    <i class="fas fa-times"></i> SOLD OUT
                                </button>
                            </div>
                        }

                        <!-- Meta Info -->
                        <div class="product-meta">
                            <div class="meta-item">
                                <span class="meta-label">SKU:</span>
                                <span class="meta-value">DTK-@Model.Id.ToString("D4")</span>
                            </div>
                            <div class="meta-item">
                                <span class="meta-label">Category:</span>
                                <a href="/products/category/@Model.Category?.Slug" class="meta-value">@Model.Category?.Name</a>
                            </div>
                            @if (Model.Weight.HasValue)
                            {
                                <div class="meta-item">
                                    <span class="meta-label">Weight:</span>
                                    <span class="meta-value">@Model.Weight g</span>
                                </div>
                            }
                        </div>

                        <!-- Shipping Info -->
                        <div class="shipping-info">
                            <div class="shipping-item">
                                <i class="fas fa-truck"></i>
                                <span>Free shipping on orders over 1,000,000 VND</span>
                            </div>
                            <div class="shipping-item">
                                <i class="fas fa-undo-alt"></i>
                                <span>30-day easy returns</span>
                            </div>
                            <div class="shipping-item">
                                <i class="fas fa-shield-alt"></i>
                                <span>12-month warranty</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Product Details Tabs -->
            <div class="product-tabs-wrapper mt-5">
                <ul class="product-tabs">
                    <li class="tab-item active" data-tab="description">Description</li>
                    <li class="tab-item" data-tab="specifications">Specifications</li>
                </ul>

                <div class="tab-content-wrapper">
                    <!-- Description Tab -->
                    <div class="tab-pane active" id="tab-description">
                        <div class="description-content">
                            @Html.Raw(Model.Description)
                        </div>
                    </div>

                    <!-- Specifications Tab -->
                    <div class="tab-pane" id="tab-specifications">
                        <div class="specifications-table">
                            @if (!string.IsNullOrEmpty(Model.Specifications))
                            {
                                try
                                {
                                    var specs = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(Model.Specifications);
                                    if (specs != null && specs.Any())
                                    {
                                        <table class="spec-table">
                                            <tbody>
                                                @foreach (var spec in specs)
                                                {
                                                    <tr>
                                                        <th>@spec.Key</th>
                                                        <td>@spec.Value</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                    else
                                    {
                                        <p>@Model.Specifications</p>
                                    }
                                }
                                catch
                                {
                                    <p>@Model.Specifications</p>
                                }
                            }
                            else
                            {
                                <p class="text-muted">No specifications available.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Related Products -->
            @if (relatedProducts != null && relatedProducts.Any())
            {
                <div class="related-products mt-5 pt-4">
                    <h3 class="related-title">You may also like</h3>
                    <div class="related-grid">
                        @foreach (var product in relatedProducts.Take(4))
                        {
                            <a href="/products/details/@product.Slug" class="related-product-card">
                                <div class="related-product-image">
                                    <img src="@product.MainImageUrl" alt="@product.Name"
                                         onerror="this.src='https://placehold.co/200x200/f5f5f5/999?text=No+Image'">
                                </div>
                                <div class="related-product-info">
                                    <h4 class="related-product-title">@product.Name</h4>
                                    <div class="related-product-price">@product.Price.ToString("N0") VND</div>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }
            <div class="card mt-4">
                <div class="card-header">
                    Customer Reviews
                </div>

                <div class="card-body">

                    @foreach (var review in Model.Reviews.OrderByDescending(x => x.CreatedAt))
                    {
                        <div class="border-bottom mb-3 pb-3">

                            <h6>
                                @review.User.FullName
                            </h6>

                            <div class="text-warning">
                                @for (int i = 1; i <= review.Rating; i++)
                                {
                                    <i class="fas fa-star"></i>
                                }
                            </div>

                            <p>@review.Comment</p>

                            <small class="text-muted">
                                @review.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </small>

                        </div>
                    }

                </div>
            </div>
            @if (User.Identity.IsAuthenticated)
            {
                <!-- REVIEW SUMMARY -->
                <div class="card mt-5 shadow-sm border-0">

                    <div class="card-body p-4">

                        <h2 class="text-center fw-bold mb-4">
                            Customer Reviews
                        </h2>

                        <div class="review-overview">

                            <!-- Average Rating -->
                            <div class="review-average">

                                <div class="avg-score">
                                    @(((double)ViewBag.AverageRating).ToString("0.0"))
                                </div>

                                <div class="avg-stars">

                                    @{
                                        double avg = ViewBag.AverageRating ?? 0;
                                    }

                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= Math.Round(avg))
                                        {
                                            <i class="fas fa-star"></i>
                                        }
                                        else
                                        {
                                            <i class="far fa-star"></i>
                                        }
                                    }

                                </div>

                                <div class="review-count">
                                    Based on <strong>@ViewBag.TotalReviews</strong> reviews
                                </div>

                            </div>

                            <!-- Rating Breakdown -->
                            <div class="review-breakdown">

                                @{
                                    int total = ViewBag.TotalReviews > 0
                                    ? ViewBag.TotalReviews
                                    : 1;
                                }

                                @for (int i = 5; i >= 1; i--)
                                {
                                    int count = i switch
                                    {
                                        5 => ViewBag.FiveStar,
                                        4 => ViewBag.FourStar,
                                        3 => ViewBag.ThreeStar,
                                        2 => ViewBag.TwoStar,
                                        _ => ViewBag.OneStar
                                    };

                                    double percent =
                                    (double)count * 100 / total;

                                    <div class="rating-row">

                                        <span class="rating-label">
                                            @i ★
                                        </span>

                                        <div class="rating-bar">

                                            <div class="rating-fill"
                                                 style="width:@percent%">
                                            </div>

                                        </div>

                                        <span class="rating-number">
                                            @count
                                        </span>

                                    </div>
                                }

                            </div>

                            <!-- Write Review Button -->
                            <div class="review-action">

                                @if (User.Identity.IsAuthenticated)
                                {
                                    <button class="btn btn-review"
                                            onclick="document.getElementById('reviewForm').scrollIntoView({behavior:'smooth'})">
                                        Write a Review
                                    </button>
                                }

                            </div>

                        </div>

                    </div>

                </div>

                <!-- REVIEW LIST -->
                <div class="card mt-4 shadow-sm border-0">

                    <div class="card-header bg-white fw-bold">
                        Customer Feedback
                    </div>

                    <div class="card-body">

                        @if (Model.Reviews.Any())
                        {
                            @foreach (var review in Model.Reviews.OrderByDescending(x => x.CreatedAt))
                            {
                                <div class="review-item">

                                    <div class="review-user">
                                        <i class="fas fa-user-circle"></i>
                                        @review.User.FullName
                                    </div>

                                    <div class="review-stars">

                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= review.Rating)
                                            {
                                                <i class="fas fa-star"></i>
                                            }
                                            else
                                            {
                                                <i class="far fa-star"></i>
                                            }
                                        }

                                    </div>

                                    <div class="review-comment">
                                        @review.Comment
                                    </div>

                                    <div class="review-date">
                                        @review.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted py-4">
                                Chưa có đánh giá nào.
                            </div>
                        }

                    </div>

                </div>

                @if (User.Identity.IsAuthenticated)
                {
                    <div id="reviewForm"
                         class="card mt-4 shadow-sm border-0">

                        <div class="card-header bg-white fw-bold">
                            Write Review
                        </div>

                        <div class="card-body">

                            <div class="rating-stars mb-3">

                                <i class="far fa-star star" data-value="1"></i>
                                <i class="far fa-star star" data-value="2"></i>
                                <i class="far fa-star star" data-value="3"></i>
                                <i class="far fa-star star" data-value="4"></i>
                                <i class="far fa-star star" data-value="5"></i>

                            </div>

                            <input type="hidden"
                                   id="rating"
                                   value="5" />

                            <textarea id="comment"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Write your review here..."></textarea>

                            <button class="btn btn-success mt-3"
                                    onclick="submitReview()">
                                Submit Review
                            </button>

                        </div>

                    </div>
                }
            }

        </div>
    </div>
}

@section Scripts {
    <script>
        // Thumbnail click to change main image
        $('.thumbnail-item').click(function() {
            var newImage = $(this).data('image');
            $('#mainProductImage').attr('src', newImage);

            // Update active state
            $('.thumbnail-item').removeClass('active');
            $(this).addClass('active');
        });

        // Quantity selector
        $('#qtyMinus').click(function() {
            var $input = $('#quantity');
            var currentVal = parseInt($input.val());
            if (currentVal > 1) {
                $input.val(currentVal - 1);
            }
        });

        $('#qtyPlus').click(function() {
            var $input = $('#quantity');
            var currentVal = parseInt($input.val());
            var maxVal = parseInt($input.attr('max'));
            if (currentVal < maxVal) {
                $input.val(currentVal + 1);
            }
        });

        // Tab switching
        $('.tab-item').click(function() {
            var tabId = $(this).data('tab');

            // Update active tab
            $('.tab-item').removeClass('active');
            $(this).addClass('active');

            // Update active content
            $('.tab-pane').removeClass('active');
            $('#tab-' + tabId).addClass('active');
        });

        // Add to cart
        $('#addToCartBtn').click(function() {
        var $btn = $(this);
        var productId = $btn.data('product-id');
        var stock = $btn.data('stock');
        var quantity = $('#quantity').val();
        
        if (stock <= 0) {
            alert('Sản phẩm đã hết hàng!');
            return;
        }
        
        if (parseInt(quantity) > stock) {
            alert('Số lượng vượt quá tồn kho!');
            return;
        }
        
        var originalText = $btn.html();
        $btn.html('<i class="fas fa-spinner fa-spin"></i> Adding...');
        $btn.prop('disabled', true);
        
        $.ajax({
            url: '/cart/add',
            type: 'POST',
            data: { productId: productId, quantity: quantity },
            success: function(response) {
                if (response.success) {
                    $('#cartCount').text(response.cartCount);
                    $('#cartCount').show();
                    $btn.html('<i class="fas fa-check"></i> Added!');
                    setTimeout(function() {
                        $btn.html(originalText);
                        $btn.prop('disabled', false);
                    }, 1500);
                } else {
                    $btn.html(originalText);
                    $btn.prop('disabled', false);
                    alert(response.message);
                }
            },
            error: function() {
                $btn.html(originalText);
                $btn.prop('disabled', false);
                alert('Có lỗi xảy ra, vui lòng thử lại!');
            }
        });
    });
        function submitReview() {

            $.ajax({

                url: '/Products/AddReview',

                type: 'POST',

                contentType: 'application/json',

                data: JSON.stringify({

                    productId: @Model.Id,

                    rating: $('#rating').val(),

                    comment: $('#comment').val()

                }),

                success: function (response) {

                    alert('Đánh giá thành công');

                    location.reload();

                },

                error: function (xhr) {

                    console.log(xhr);

                    alert('Có lỗi xảy ra');

                }

            });

        }
        $(document).ready(function () {

            $('.star').click(function () {

                let rating = $(this).data('value');

                $('#rating').val(rating);

                $('.star').removeClass('active');

                $('.star').each(function () {

                    if ($(this).data('value') <= rating) {

                        $(this).addClass('active');

                    }

                });

            });

            $('.star[data-value="5"]').click();

        });
    </script>
}

@section Styles {
    <style>
        .review-overview {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 40px;
            flex-wrap: wrap;
        }

        .review-average {
            min-width: 220px;
            text-align: center;
        }

        .avg-score {
            font-size: 48px;
            font-weight: 700;
            color: #222;
        }

        .avg-stars {
            color: #f7b500;
            font-size: 24px;
            margin: 10px 0;
        }

        .review-count {
            color: #666;
        }

        .review-breakdown {
            flex: 1;
            min-width: 320px;
        }

        .rating-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
        }

        .rating-label {
            width: 40px;
        }

        .rating-number {
            width: 30px;
            text-align: right;
        }

        .rating-bar {
            flex: 1;
            height: 12px;
            background: #ececec;
            border-radius: 30px;
            overflow: hidden;
        }

        .rating-fill {
            height: 100%;
            background: #0d9488;
        }

        .btn-review {
            background: #0d9488;
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 8px;
        }

            .btn-review:hover {
                color: white;
                opacity: .9;
            }

        .review-item {
            padding: 15px 0;
            border-bottom: 1px solid #eee;
        }

        .review-user {
            font-weight: 600;
            margin-bottom: 5px;
        }

        .review-stars {
            color: #f7b500;
            margin-bottom: 8px;
        }

        .review-date {
            color: #999;
            font-size: 13px;
            margin-top: 8px;
        }

        .rating-stars {
            font-size: 36px;
        }

            .rating-stars .star {
                color: #ddd;
                cursor: pointer;
                transition: .2s;
            }

                .rating-stars .star.active {
                    color: #f7b500;
                }

                .rating-stars .star:hover {
                    transform: scale(1.15);
                }

        .product-detail-container {
            background: #ffffff;
            min-height: 100vh;
        }

        /* Breadcrumb */
        .breadcrumb-wrapper {
            border-bottom: 1px solid #e5e5e5;
            margin-bottom: 2rem;
        }

        .breadcrumb {
            background: transparent;
            padding: 0;
        }

        .breadcrumb-item a {
            color: #666;
            text-decoration: none;
            font-size: 14px;
        }

        .breadcrumb-item.active {
            color: #000;
            font-weight: 500;
        }

        /* Product Gallery */
        .product-gallery {
            position: sticky;
            top: 20px;
        }

        .main-image-wrapper {
            background: #f8f8f8;
            border-radius: 12px;
            padding: 2rem;
            margin-bottom: 1rem;
        }

        .main-product-image {
            width: 100%;
            height: auto;
            object-fit: contain;
        }

        .thumbnail-wrapper {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        .thumbnail-item {
            width: 80px;
            height: 80px;
            background: #f8f8f8;
            border-radius: 8px;
            padding: 0.5rem;
            cursor: pointer;
            border: 2px solid transparent;
            transition: all 0.2s;
        }

            .thumbnail-item img {
                width: 100%;
                height: 100%;
                object-fit: contain;
            }

            .thumbnail-item:hover {
                border-color: #ddd;
            }

            .thumbnail-item.active {
                border-color: #000;
            }

        /* Product Info */
        .product-info {
            padding-right: 1rem;
        }

        .stock-badge {
            margin-bottom: 1rem;
        }

        .in-stock {
            color: #00a650;
            font-size: 14px;
            font-weight: 500;
        }

            .in-stock i {
                margin-right: 0.25rem;
            }

        .out-of-stock {
            color: #ff4444;
            font-size: 14px;
            font-weight: 500;
        }

        .product-title {
            font-size: 1.75rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: #000;
        }

        .product-price {
            margin-bottom: 1rem;
        }

        .current-price {
            font-size: 1.5rem;
            font-weight: 700;
            color: #000;
        }

        .old-price {
            font-size: 1rem;
            color: #999;
            text-decoration: line-through;
            margin-left: 0.5rem;
        }

        .save-price {
            display: inline-block;
            margin-left: 0.5rem;
            font-size: 0.85rem;
            color: #00a650;
        }

        .product-rating {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }

        .stars {
            display: flex;
            gap: 2px;
        }

            .stars i {
