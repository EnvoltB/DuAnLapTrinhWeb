@using GearDTK.Controllers
@using static GearDTK.Controllers.ProductsController
@model PaginatedList<GearDTK.Models.Product>
@{
    ViewData["Title"] = "Tất cả sản phẩm - GearDTK";
}

<div class="shop-container">
    <div class="container-fluid px-4">
        <!-- Breadcrumb -->
        <div class="breadcrumb-wrapper py-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">All products</li>
                </ol>
            </nav>
        </div>

        <div class="row">
            <!-- Sidebar Filters -->
            <div class="col-lg-3 col-md-4">
                <div class="filter-sidebar">
                    <div class="filter-header">
                        <h5 class="filter-title">Filters</h5>
                        <span class="product-count-badge">@Model.TotalPages products</span>
                    </div>

                    <!-- Availability Filter -->
                    <div class="filter-group">
                        <h6 class="filter-heading">Availability</h6>
                        <div class="filter-options">
                            <label class="filter-checkbox">
                                <input type="checkbox" id="inStockCheckbox"> In Stock
                                <span class="checkmark"></span>
                            </label>
                            <label class="filter-checkbox">
                                <input type="checkbox" id="outOfStockCheckbox"> Out of Stock
                                <span class="checkmark"></span>
                            </label>
                        </div>
                    </div>

                    <!-- Product Type Filter -->
                    <div class="filter-group">
                        <h6 class="filter-heading">Product type</h6>
                        <div class="filter-options">
                            <label class="filter-checkbox">
                                <input type="checkbox" value="gaming-mice" class="category-filter"> Gaming Mice
                                <span class="checkmark"></span>
                            </label>
                            <label class="filter-checkbox">
                                <input type="checkbox" value="gaming-keyboards" class="category-filter"> Gaming Keyboards
                                <span class="checkmark"></span>
                            </label>
                            <label class="filter-checkbox">
                                <input type="checkbox" value="mouse-pads" class="category-filter"> Mouse Pads
                                <span class="checkmark"></span>
                            </label>
                            <label class="filter-checkbox">
                                <input type="checkbox" value="gaming-headsets" class="category-filter"> Gaming Headsets
                                <span class="checkmark"></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Products Main Content -->
            <div class="col-lg-9 col-md-8">
                <!-- Sort Bar -->
                <div class="sort-bar">
                    <div class="sort-left">
                        <span class="results-count">@Model.TotalPages products</span>
                    </div>
                    <div class="sort-right">
                        <label class="sort-label">Sort by:</label>
                        <select id="sortSelect" class="sort-select">
                            <option value="name_asc">Alphabetically, A-Z</option>
                            <option value="name_desc">Alphabetically, Z-A</option>
                            <option value="price_asc">Price, low to high</option>
                            <option value="price_desc">Price, high to low</option>
                            <option value="newest">Newest first</option>
                            <option value="bestseller">Best selling</option>
                        </select>
                    </div>
                </div>

                <!-- Products Grid -->
                @if (!Model.Any())
                {
                    <div class="empty-state">
                        <i class="fas fa-box-open fa-3x mb-3"></i>
                        <h4>No products found</h4>
                        <p>Try adjusting your filters or search terms</p>
                    </div>
                }
                else
                {
                    <div class="products-grid" id="productsGrid">
                        @foreach (var product in Model)
                        {
                            <div class="product-item"
                                 data-name="@product.Name"
                                 data-price="@product.Price"
                                 data-category="@product.Category?.Slug"
                                 data-stock="@(product.StockQuantity > 0 ? "instock" : "outofstock")">

                                <!-- Product Badges -->
                                <div class="product-badges">
                                    @if (product.StockQuantity <= 0)
                                    {
                                        <span class="badge-soldout">Sold Out</span>
                                    }
                                    @if (product.DiscountPercent.HasValue && product.StockQuantity > 0)
                                    {
                                        <span class="badge-sale">-@product.DiscountPercent%</span>
                                    }
                                    @if (product.IsNew && product.StockQuantity > 0)
                                    {
                                        <span class="badge-new">New</span>
                                    }
                                </div>

                                <!-- ========== WISHLIST ICON (TRÁI TIM) ========== -->
                                <button class="wishlist-icon" data-id="@product.Id" title="Thêm vào yêu thích">
                                    <i class="far fa-heart"></i>
                                </button>

                                <!-- Product Image -->
                                <a href="/products/details/@product.Slug" class="product-image-link">
                                    <div class="product-image">
                                        <img src="@product.MainImageUrl" alt="@product.Name"
                                             onerror="this.src='https://placehold.co/400x400/f5f5f5/999?text=No+Image'">
                                    </div>
                                </a>

                                <!-- Product Info -->
                                <div class="product-info">
                                    <h3 class="product-title">
                                        <a href="/products/details/@product.Slug">@product.Name</a>
                                    </h3>

                                    <div class="product-price">
                                        @if (product.ComparePrice.HasValue && product.ComparePrice > product.Price)
                                        {
                                            <span class="current-price">@product.Price.ToString("N0") VND</span>
                                            <span class="old-price">@product.ComparePrice.Value.ToString("N0") VND</span>
                                        }
                                        else
                                        {
                                            <span class="current-price">@product.Price.ToString("N0") VND</span>
                                        }
                                    </div>

                                    <!-- Rating Stars -->
                                    <div class="product-rating">
                                        <div class="stars">
                                            <i class="fas fa-star"></i>
                                            <i class="fas fa-star"></i>
                                            <i class="fas fa-star"></i>
                                            <i class="fas fa-star"></i>
                                            <i class="fas fa-star-half-alt"></i>
                                        </div>
                                        <span class="rating-count">(@Random.Shared.Next(10, 500) reviews)</span>
                                    </div>

                                    <!-- Add to Cart Button -->
                                    @if (product.StockQuantity > 0)
                                    {
                                        <button class="btn-add-cart" data-id="@product.Id" data-stock="@product.StockQuantity">
                                            <i class="fas fa-shopping-cart"></i> Add to cart
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn-add-cart disabled" disabled>
                                            <i class="fas fa-times"></i> Out of stock
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
                    var nextDisabled = !Model.HasNextPage ? "disabled" : "";

                    <div class="pagination-wrapper">
                        <ul class="pagination">
                            <li class="page-item @prevDisabled">
                                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>

                            @{
                                int start = Math.Max(1, Model.PageIndex - 2);
                                int end = Math.Min(Model.TotalPages, Model.PageIndex + 2);
                            }

                            @if (start > 1)
                            {
                                <li class="page-item"><a class="page-link" asp-action="Index" asp-route-pageNumber="1">1</a></li>
                                if (start > 2)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                            }

                            @for (int i = start; i <= end; i++)
                            {
                                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@i">@i</a>
                                </li>
                            }

                            @if (end < Model.TotalPages)
                            {
                                if (end < Model.TotalPages - 1)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                                <li class="page-item"><a class="page-link" asp-action="Index" asp-route-pageNumber="@Model.TotalPages">@Model.TotalPages</a></li>
                            }

                            <li class="page-item @nextDisabled">
                                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Shop Container */
        .shop-container {
            background: #ffffff;
            min-height: 100vh;
        }

        /* Breadcrumb */
        .breadcrumb-wrapper {
            border-bottom: 1px solid #e5e5e5;
            margin-bottom: 1.5rem;
        }

        .breadcrumb {
            background: transparent;
            padding: 0;
        }

        .breadcrumb-item a {
            color: #666;
            text-decoration: none;
            font-size: 14px;
        }

        .breadcrumb-item.active {
            color: #000;
            font-weight: 500;
        }

        .breadcrumb-item + .breadcrumb-item::before {
            content: "/";
            color: #ccc;
        }

        /* Filter Sidebar */
        .filter-sidebar {
            padding-right: 2rem;
        }

        .filter-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 1.5rem;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid #e5e5e5;
        }

        .filter-title {
            font-size: 1rem;
            font-weight: 600;
            margin: 0;
            letter-spacing: 1px;
        }

        .product-count-badge {
            color: #666;
            font-size: 14px;
        }

        .filter-group {
            margin-bottom: 2rem;
        }

        .filter-heading {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 1rem;
            letter-spacing: 0.5px;
        }

        .filter-options {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .filter-checkbox {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            cursor: pointer;
            font-size: 14px;
            color: #333;
        }

        .filter-checkbox input {
            width: 16px;
            height: 16px;
            cursor: pointer;
        }

        /* Sort Bar */
        .sort-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #e5e5e5;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .results-count {
            font-size: 14px;
            color: #666;
        }

        .sort-right {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .sort-label {
            font-size: 14px;
            color: #666;
        }

        .sort-select {
            padding: 6px 12px;
            border: 1px solid #ddd;
            border-radius: 4px;
            background: white;
            font-size: 13px;
            cursor: pointer;
        }

        /* Products Grid */
        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 2rem;
        }

        .product-item {
            position: relative;
            transition: transform 0.2s ease;
        }

        .product-item:hover {
            transform: translateY(-2px);
        }

        /* Product Badges */
        .product-badges {
            position: absolute;
            top: 12px;
            left: 12px;
            z-index: 2;
            display: flex;
            gap: 0.5rem;
        }

        .badge-soldout {
            background: #000;
            color: white;
            padding: 4px 8px;
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .badge-sale {
            background: #ff4444;
            color: white;
            padding: 4px 8px;
            font-size: 11px;
            font-weight: 500;
        }

        .badge-new {
            background: #000;
            color: white;
            padding: 4px 8px;
            font-size: 11px;
            font-weight: 500;
        }

        /* Wishlist Icon */
        .wishlist-icon {
            position: absolute;
            top: 12px;
            right: 12px;
            background: white;
            border: none;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            cursor: pointer;
            z-index: 10;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            transition: all 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .wishlist-icon i {
            font-size: 1.2rem;
            color: #999;
            transition: all 0.3s;
        }

        .wishlist-icon:hover {
            background: #ff4444;
        }

        .wishlist-icon:hover i {
            color: white;
        }

        .wishlist-icon.active {
            background: #ff4444;
        }

        .wishlist-icon.active i {
            color: white;
        }

        /* Product Image */
        .product-image-link {
            display: block;
            text-decoration: none;
        }

        .product-image {
            background: #f8f8f8;
            border-radius: 8px;
            overflow: hidden;
            aspect-ratio: 1 / 1;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .product-image img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            padding: 1rem;
            transition: transform 0.3s ease;
        }

        .product-item:hover .product-image img {
            transform: scale(1.05);
        }

        /* Product Info */
        .product-info {
            margin-top: 1rem;
            text-align: left;
        }

        .product-title {
            font-size: 1rem;
            font-weight: 500;
            margin-bottom: 0.5rem;
            line-height: 1.4;
        }

        .product-title a {
            color: #000;
            text-decoration: none;
        }

        .product-title a:hover {
            text-decoration: underline;
        }

        .product-price {
            margin-bottom: 0.5rem;
        }

        .current-price {
            font-size: 1rem;
            font-weight: 600;
            color: #000;
        }

        .old-price {
            font-size: 0.85rem;
            color: #999;
            text-decoration: line-through;
            margin-left: 0.5rem;
        }

        /* Rating */
        .product-rating {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 0.75rem;
        }

        .stars {
            display: flex;
            gap: 2px;
        }

        .stars i {
            font-size: 11px;
            color: #ffc107;
        }

        .rating-count {
            font-size: 12px;
            color: #666;
        }

        /* Add to Cart Button */
        .btn-add-cart {
            width: 100%;
            background: #000;
            border: 1px solid #000;
            padding: 10px;
            border-radius: 6px;
            color: white;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-add-cart:hover {
            background: #333;
            border-color: #333;
        }

        .btn-add-cart.disabled {
            background: #f0f0f0;
            border-color: #ddd;
            color: #999;
            cursor: not-allowed;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 4rem;
            color: #666;
        }

        /* Pagination */
        .pagination-wrapper {
            margin-top: 3rem;
            display: flex;
            justify-content: flex-end;
        }

        .pagination {
            gap: 0.25rem;
        }

        .page-item .page-link {
            color: #000;
            background: transparent;
            border: none;
            padding: 6px 12px;
            font-size: 14px;
        }

        .page-item.active .page-link {
            background: #000;
            color: white;
            border-radius: 4px;
        }

        .page-item.disabled .page-link {
            color: #ccc;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .filter-sidebar {
                padding-right: 0;
                margin-bottom: 2rem;
            }

            .products-grid {
                grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
                gap: 1rem;
            }

            .product-title {
                font-size: 0.85rem;
            }

            .current-price {
                font-size: 0.9rem;
            }

            .sort-bar {
                flex-direction: column;
                align-items: flex-start;
            }

            .wishlist-icon {
                width: 30px;
                height: 30px;
            }

            .wishlist-icon i {
                font-size: 1rem;
            }
        }
    </style>
}

@section Scripts {
    <script>
        // Filter by category
        $('.category-filter').on('change', function() {
            var selectedCategories = $('.category-filter:checked').map(function() {
                return $(this).val();
            }).get();

            $('.product-item').each(function() {
                var $item = $(this);
                var category = $item.data('category');

                if (selectedCategories.length === 0 || selectedCategories.includes(category)) {
                    $item.show();
                } else {
                    $item.hide();
                }
            });

            updateResultCount();
        });

        // Filter by stock
        $('#inStockCheckbox, #outOfStockCheckbox').on('change', function() {
            var showInStock = $('#inStockCheckbox').is(':checked');
            var showOutOfStock = $('#outOfStockCheckbox').is(':checked');

            var showAll = !showInStock && !showOutOfStock;

            $('.product-item').each(function() {
                var $item = $(this);
                var stockStatus = $item.data('stock');

                if (showAll) {
                    $item.show();
                } else if (showInStock && stockStatus === 'instock') {
                    $item.show();
                } else if (showOutOfStock && stockStatus === 'outofstock') {
                    $item.show();
                } else {
                    $item.hide();
                }
            });

            updateResultCount();
        });

        // Sort functionality
        $('#sortSelect').on('change', function() {
            var sortBy = $(this).val();
            var $grid = $('.products-grid');
            var $items = $grid.children('.product-item').get();

            $items.sort(function(a, b) {
                var $a = $(a);
                var $b = $(b);

                if (sortBy === 'name_asc') {
                    return $a.data('name').localeCompare($b.data('name'));
                } else if (sortBy === 'name_desc') {
                    return $b.data('name').localeCompare($a.data('name'));
                } else if (sortBy === 'price_asc') {
                    return $a.data('price') - $b.data('price');
                } else if (sortBy === 'price_desc') {
                    return $b.data('price') - $a.data('price');
                }
                return 0;
            });

            $.each($items, function(idx, item) {
                $grid.append(item);
            });
        });

        // Update visible result count
        function updateResultCount() {
            var visibleCount = $('.product-item:visible').length;
            $('.results-count').text(visibleCount + ' products');
        }

        // Add to cart function
        $('.btn-add-cart:not(.disabled)').click(function(e) {
            e.preventDefault();
            var $btn = $(this);
            var productId = $btn.data('id');
            var stock = $btn.data('stock');
            
            if (stock <= 0) {
                alert('Sản phẩm đã hết hàng!');
                return;
            }
            
            var originalText = $btn.html();
            $btn.html('<i class="fas fa-spinner fa-spin"></i> Adding...');
            $btn.prop('disabled', true);
            
            $.ajax({
                url: '/ShoppingCart/AddToCart',
                type: 'POST',
                data: { productId: productId, quantity: 1 },
                success: function(response) {
                    if (response.success) {
                        $('#cartCount').text(response.cartCount);
                        $('#cartCount').show();
                        $btn.html('<i class="fas fa-check"></i> Added!');
                        setTimeout(function() {
                            $btn.html(originalText);
                            $btn.prop('disabled', false);
                        }, 1500);
                    } else {
                        $btn.html(originalText);
                        $btn.prop('disabled', false);
                        alert(response.message || 'Có lỗi xảy ra!');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('AJAX Error:', error);
                    $btn.html(originalText);
                    $btn.prop('disabled', false);
                    alert('Có lỗi xảy ra, vui lòng thử lại!');
                }
            });
        });

        // Wishlist icon click handler
        $(document).on('click', '.wishlist-icon', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            var $btn = $(this);
            var productId = $btn.data('id');
            var $icon = $btn.find('i');
            
            $.ajax({
                url: '/Account/AddToWishlist',
                type: 'POST',
                data: { productId: productId },
                success: function(response) {
                    if (response.success) {
                        $btn.addClass('active');
                        $icon.removeClass('far').addClass('fas');
                        
                        // Cập nhật số lượng wishlist trên header
                        if (typeof updateWishlistCount === 'function') {
                            updateWishlistCount();
                        }
                        
                        // Hiển thị thông báo
                        var toast = $('<div class="alert alert-success position-fixed bottom-0 end-0 m-3" style="z-index: 9999; background: #28a745; color: white; border: none;">' +
                            '<i class="fas fa-heart"></i> Đã thêm vào danh sách yêu thích' +
                            '</div>');
                        $('body').append(toast);
                        setTimeout(function() { toast.fadeOut(300, function() { $(this).remove(); }); }, 2000);
                    } else {
                        alert(response.message);
                    }
                },
                error: function() {
                    alert('Có lỗi xảy ra, vui lòng thử lại!');
                }
            });
        });
    </script>
}