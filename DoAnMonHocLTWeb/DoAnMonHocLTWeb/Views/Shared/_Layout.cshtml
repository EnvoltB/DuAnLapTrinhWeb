<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <meta name="description" content="GearDTK - Premium Gaming Gear for Esports & Gamers">
    <title>@ViewData["Title"] - GearDTK</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- ========== HEADER ========== -->
    <!-- Top Bar -->
    <div class="top-bar text-white py-2">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 d-none d-md-block">
                    <small><i class="fas fa-truck"></i> Free Shipping on Orders Over $50</small>
                </div>
                <div class="col-md-6 text-md-end text-center">
                    <!-- Language Dropdown -->
                    <div class="dropdown d-inline-block me-3">
                        <button class="btn btn-link text-white text-decoration-none dropdown-toggle p-0" type="button" data-bs-toggle="dropdown">
                            <i class="fas fa-globe me-1"></i> English / VND
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">English / USD</a></li>
                            <li><a class="dropdown-item" href="#">Tiếng Việt / VND</a></li>
                        </ul>
                    </div>

                    <!-- Account Section -->
                    @if (User.Identity.IsAuthenticated)
                    {
                        <div class="dropdown d-inline-block">
                            <button class="btn btn-link text-white text-decoration-none dropdown-toggle p-0" type="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle me-1"></i> @User.Identity.Name
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/Account/Profile"><i class="fas fa-user"></i> Hồ sơ</a></li>
                                <li><a class="dropdown-item" href="/Account/OrderHistory"><i class="fas fa-shopping-bag"></i> Đơn hàng</a></li>
                                <li><a class="dropdown-item" href="/Account/Wishlist"><i class="fas fa-heart"></i> Yêu thích</a></li>

                                @if (User.IsInRole("Admin"))
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/Admin/Dashboard"><i class="fas fa-tachometer-alt"></i> Admin Dashboard</a></li>
                                }
                                @if (User.IsInRole("Employee"))
                                {
                                    <li><a class="dropdown-item" href="/Employee/Dashboard"><i class="fas fa-briefcase"></i> Employee Dashboard</a></li>
                                }
                                @if (User.IsInRole("Supplier"))
                                {
                                    <li><a class="dropdown-item" href="/Supplier/Dashboard"><i class="fas fa-truck"></i> Supplier Dashboard</a></li>
                                }

                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a href="/Account/Logout" class="dropdown-item text-danger">
                                        <i class="fas fa-sign-out-alt"></i> Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="/Account/Login" class="text-white text-decoration-none me-3">
                            <i class="fas fa-user"></i> Account
                        </a>
                    }

                    <a href="/Support" class="text-white text-decoration-none">
                        <i class="fas fa-headset"></i> Support
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Header -->
    <header class="main-header">
        <nav class="navbar navbar-expand-lg py-3">
            <div class="container">
                <!-- Logo -->
                <a class="navbar-brand" href="/">
                    <i class="fas fa-gamepad me-2"></i>
                    <span class="fw-bold fs-4 gradient-text">GearDTK</span>
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation Menu -->
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link fw-semibold @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" href="/">
                                <i class="fas fa-home"></i> Home
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle fw-semibold" href="#" data-bs-toggle="dropdown">
                                <i class="fas fa-box"></i> All Products
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/products"><i class="fas fa-boxes"></i> Tất cả sản phẩm</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="/products/category/gaming-mice"><i class="fas fa-mouse"></i> Gaming Mice</a></li>
                                <li><a class="dropdown-item" href="/products/category/gaming-keyboards"><i class="fas fa-keyboard"></i> Gaming Keyboards</a></li>
                                <li><a class="dropdown-item" href="/products/category/mouse-pads"><i class="fas fa-square"></i> Mouse Pads</a></li>
                                <li><a class="dropdown-item" href="/products/category/gaming-headsets"><i class="fas fa-headphones"></i> Gaming Headsets</a></li>
                            </ul>
                        </li>
                        <li class="nav-item"><a class="nav-link fw-semibold" href="/products/category/gaming-mice"><i class="fas fa-mouse"></i> Mice</a></li>
                        <li class="nav-item"><a class="nav-link fw-semibold" href="/products/category/gaming-keyboards"><i class="fas fa-keyboard"></i> Keyboards</a></li>
                        <li class="nav-item"><a class="nav-link fw-semibold" href="/products/category/mouse-pads"><i class="fas fa-square"></i> Mouse Pads</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle fw-semibold" href="#" data-bs-toggle="dropdown">
                                <i class="fas fa-life-ring"></i> Support
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/support/faq"><i class="fas fa-question-circle"></i> FAQ</a></li>
                                <li><a class="dropdown-item" href="/support/warranty"><i class="fas fa-shield-alt"></i> Warranty</a></li>
                                <li><a class="dropdown-item" href="/support/shipping"><i class="fas fa-truck"></i> Shipping</a></li>
                                <li><a class="dropdown-item" href="/support/returns"><i class="fas fa-undo-alt"></i> Returns</a></li>
                            </ul>
                        </li>
                        <li class="nav-item"><a class="nav-link fw-semibold" href="/hub"><i class="fas fa-download"></i> Software</a></li>
                        <li class="nav-item"><a class="nav-link fw-semibold" href="/community"><i class="fas fa-users"></i> Community</a></li>
                    </ul>

                    <!-- Header Icons -->
                    <div class="header-icons d-flex align-items-center gap-3">
                        <a href="/search" class="icon-link">
                            <i class="fas fa-search fa-lg"></i>
                        </a>
                        <a href="/account/wishlist" class="icon-link position-relative">
                            <i class="fas fa-heart fa-lg"></i>
                            <span class="wishlist-count position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">0</span>
                        </a>
                        <a href="/ShoppingCart/Index" class="icon-link position-relative">
                            <i class="fas fa-shopping-bag fa-lg"></i>
                            <span class="cart-count position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="cartCount">0</span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- ========== MAIN CONTENT ========== -->
    <main role="main">
        <!-- Thông báo -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show text-center m-3" role="alert">
                <i class="fas fa-check-circle"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show text-center m-3" role="alert">
                <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <!-- ========== FOOTER ========== -->
    <footer class="footer text-white pt-5 pb-4">
        <div class="container">
            <div class="row">
                <!-- Column 1: Brand -->
                <div class="col-lg-3 col-md-6 mb-4">
                    <h5 class="fw-bold mb-3 gradient-text">GearDTK</h5>
                    <p class="text-white-50">Premium gaming gear for competitive gamers and esports professionals.</p>
                    <div class="social-links mt-3">
                        <a href="#" class="text-white me-3"><i class="fab fa-facebook-f fa-lg"></i></a>
                        <a href="#" class="text-white me-3"><i class="fab fa-twitter fa-lg"></i></a>
                        <a href="#" class="text-white me-3"><i class="fab fa-instagram fa-lg"></i></a>
                        <a href="#" class="text-white me-3"><i class="fab fa-discord fa-lg"></i></a>
                        <a href="#" class="text-white"><i class="fab fa-youtube fa-lg"></i></a>
                    </div>
                </div>

                <!-- Column 2: Shop -->
                <div class="col-lg-2 col-md-6 mb-4">
                    <h6 class="fw-bold mb-3">Shop</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="/products" class="text-white-50 text-decoration-none">All Products</a></li>
                        <li class="mb-2"><a href="/products/category/gaming-mice" class="text-white-50 text-decoration-none">Gaming Mice</a></li>
                        <li class="mb-2"><a href="/products/category/gaming-keyboards" class="text-white-50 text-decoration-none">Keyboards</a></li>
                        <li class="mb-2"><a href="/products/category/mouse-pads" class="text-white-50 text-decoration-none">Mouse Pads</a></li>
                        <li class="mb-2"><a href="/products/category/gaming-headsets" class="text-white-50 text-decoration-none">Headsets</a></li>
                    </ul>
                </div>

                <!-- Column 3: Support -->
                <div class="col-lg-2 col-md-6 mb-4">
                    <h6 class="fw-bold mb-3">Support</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none">Contact Us</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none">FAQ</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none">Warranty</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none">Shipping Info</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none">Returns</a></li>
                    </ul>
                </div>

                <!-- Column 4: Features -->
                <div class="col-lg-2 col-md-6 mb-4">
                    <h6 class="fw-bold mb-3">Features</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none">GearDTK Software</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none">Esports Partners</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none">Community</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none">Blog</a></li>
                    </ul>
                </div>

                <!-- Column 5: Newsletter -->
                <div class="col-lg-3 col-md-12 mb-4">
                    <h6 class="fw-bold mb-3">Newsletter</h6>
                    <p class="text-white-50 small">Subscribe to get special offers, free giveaways, and exclusive deals.</p>
                    <form class="newsletter-form" id="newsletterForm">
                        <div class="input-group">
                            <input type="email" class="form-control" placeholder="Your email" id="newsletterEmail">
                            <button class="btn btn-primary" type="submit">
                                <i class="fas fa-paper-plane"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <hr class="mt-4 mb-3 bg-secondary">

            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <small class="text-white-50">© 2025 GearDTK. All rights reserved.</small>
                </div>
                <div class="col-md-6 text-center text-md-end mt-2 mt-md-0">
                    <span class="text-white-50">
                        <i class="fab fa-cc-visa fa-lg me-2"></i>
                        <i class="fab fa-cc-mastercard fa-lg me-2"></i>
                        <i class="fab fa-cc-paypal fa-lg me-2"></i>
                        <i class="fab fa-cc-amex fa-lg"></i>
                    </span>
                </div>
            </div>
        </div>
    </footer>

    <!-- ========== SCRIPTS ========== -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/cart.js"></script>

    <script>
        // Newsletter form submit
        $('#newsletterForm').submit(function(e) {
        e.preventDefault();
        var email = $('#newsletterEmail').val();
        if (email) {
        alert('Cảm ơn ' + email + ' đã đăng ký nhận tin!');
        $('#newsletterEmail').val('');
        }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>