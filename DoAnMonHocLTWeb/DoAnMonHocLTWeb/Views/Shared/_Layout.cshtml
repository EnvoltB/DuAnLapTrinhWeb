<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <meta name="description" content="GearDTK - Premium Gaming Gear for Esports & Gamers">
    <title>@ViewData["Title"] - GearDTK</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- ========== HEADER ========== -->
    <!-- Top Bar -->
    <div class="top-bar text-white py-2">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 d-none d-md-block">
                    <small><i class="fas fa-truck"></i> Free Shipping on Orders Over $50</small>
                </div>
                <div class="col-md-6 text-md-end text-center">
                    <div class="dropdown d-inline-block me-3">
                        <button class="btn btn-link text-white text-decoration-none dropdown-toggle p-0" type="button" data-bs-toggle="dropdown">
                            <i class="fas fa-globe me-1"></i> English / VND
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">English / USD</a></li>
                            <li><a class="dropdown-item" href="#">Tiếng Việt / VND</a></li>
                        </ul>
                    </div>

                    @if (User.Identity.IsAuthenticated)
                    {
                        <div class="dropdown d-inline-block">
                            <button class="btn btn-link text-white text-decoration-none dropdown-toggle p-0" type="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle me-1"></i> @User.Identity.Name
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/Account/Profile"><i class="fas fa-user"></i> Hồ sơ</a></li>
                                <li><a class="dropdown-item" href="/Account/OrderHistory"><i class="fas fa-shopping-bag"></i> Đơn hàng</a></li>
                                <li><a class="dropdown-item" href="/Account/Wishlist"><i class="fas fa-heart"></i> Yêu thích</a></li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" href="/Admin/Dashboard">
                                            <i class="fas fa-tachometer-alt"></i> Admin Dashboard
                                            <span class="badge bg-danger ms-1" id="newOrderBadge" style="display: none;">0</span>
                                        </a>
                                    </li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li><a href="/Account/Logout" class="dropdown-item text-danger">Đăng xuất</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="/Account/Login" class="text-white text-decoration-none me-3">Account</a>
                    }
                    <a href="/Support" class="text-white text-decoration-none">Support</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Header -->
    <header class="main-header">
        <nav class="navbar navbar-expand-lg py-3">
            <div class="container">
                <!-- Logo -->
                <a class="navbar-brand" href="/">
                    <i class="fas fa-gamepad me-2"></i>
                    <span class="fw-bold fs-4 gradient-text">GearDTK</span>
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation Menu -->
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link fw-semibold @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" href="/">Home</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle fw-semibold" href="#" data-bs-toggle="dropdown">
                                <i class="fas fa-box"></i> All Products
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/products"><i class="fas fa-boxes"></i> Tất cả sản phẩm</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="/products/category/gaming-mice"><i class="fas fa-mouse"></i> Gaming Mice</a></li>
                                <li><a class="dropdown-item" href="/products/category/gaming-keyboards"><i class="fas fa-keyboard"></i> Gaming Keyboards</a></li>
                                <li><a class="dropdown-item" href="/products/category/mouse-pads"><i class="fas fa-square"></i> Mouse Pads</a></li>
                                <li><a class="dropdown-item" href="/products/category/gaming-headsets"><i class="fas fa-headphones"></i> Gaming Headsets</a></li>
                            </ul>
                        </li>
                        <li class="nav-item"><a class="nav-link fw-semibold" href="/products/category/gaming-mice">Mice</a></li>
                        <li class="nav-item"><a class="nav-link fw-semibold" href="/products/category/gaming-keyboards">Keyboards</a></li>
                        <li class="nav-item"><a class="nav-link fw-semibold" href="/products/category/mouse-pads">Mouse Pads</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle fw-semibold" href="#" data-bs-toggle="dropdown">Support</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/support/faq">FAQ</a></li>
                                <li><a class="dropdown-item" href="/support/warranty">Warranty</a></li>
                                <li><a class="dropdown-item" href="/support/shipping">Shipping</a></li>
                                <li><a class="dropdown-item" href="/support/returns">Returns</a></li>
                            </ul>
                        </li>
                        <li class="nav-item"><a class="nav-link fw-semibold" href="/hub">Software</a></li>
                        <li class="nav-item"><a class="nav-link fw-semibold" href="/community">Community</a></li>
                    </ul>

                    <!-- Header Icons -->
                    <div class="header-icons d-flex align-items-center gap-3">
                        <form action="/products/search" method="get" class="search-form-header">
                            <input type="text" name="keyword" class="search-input-header" placeholder="Tìm kiếm sản phẩm..." value="@Context.Request.Query["keyword"]">
                            <button type="submit" class="search-btn-header">
                                <i class="fas fa-search"></i>
                            </button>
                        </form>
                        <a href="/Account/Wishlist" class="icon-link position-relative">
                            <i class="fas fa-heart fa-lg"></i>
                            <span class="wishlist-count badge bg-danger" id="wishlistCount">0</span>
                        </a>
                        <a href="/ShoppingCart/Index" class="icon-link position-relative">
                            <i class="fas fa-shopping-bag fa-lg"></i>
                            <span class="cart-count badge bg-danger" id="cartCount">0</span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- ========== MAIN CONTENT ========== -->
    <main role="main">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show text-center m-3" role="alert">
                <i class="fas fa-check-circle"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show text-center m-3" role="alert">
                <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    <!-- ========== FOOTER ========== -->
    <footer class="footer text-white pt-5 pb-4">
        <div class="container">
            <div class="row">
                <div class="col-lg-3 col-md-6 mb-4">
                    <h5 class="fw-bold mb-3 gradient-text">GearDTK</h5>
                    <p class="text-white-50">Premium gaming gear for competitive gamers and esports professionals.</p>
                    <div class="social-links mt-3">
                        <a href="#" class="text-white me-3"><i class="fab fa-facebook-f fa-lg"></i></a>
                        <a href="#" class="text-white me-3"><i class="fab fa-twitter fa-lg"></i></a>
                        <a href="#" class="text-white me-3"><i class="fab fa-instagram fa-lg"></i></a>
                        <a href="#" class="text-white me-3"><i class="fab fa-discord fa-lg"></i></a>
                        <a href="#" class="text-white"><i class="fab fa-youtube fa-lg"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6 mb-4">
                    <h6 class="fw-bold mb-3">Shop</h6>
                    <ul class="list-unstyled">
                        <li><a href="/products" class="text-white-50">All Products</a></li>
                        <li><a href="/products/category/gaming-mice" class="text-white-50">Gaming Mice</a></li>
                        <li><a href="/products/category/gaming-keyboards" class="text-white-50">Keyboards</a></li>
                        <li><a href="/products/category/mouse-pads" class="text-white-50">Mouse Pads</a></li>
                        <li><a href="/products/category/gaming-headsets" class="text-white-50">Headsets</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-6 mb-4">
                    <h6 class="fw-bold mb-3">Support</h6>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-white-50">Contact Us</a></li>
                        <li><a href="#" class="text-white-50">FAQ</a></li>
                        <li><a href="#" class="text-white-50">Warranty</a></li>
                        <li><a href="#" class="text-white-50">Shipping</a></li>
                        <li><a href="#" class="text-white-50">Returns</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-6 mb-4">
                    <h6 class="fw-bold mb-3">Features</h6>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-white-50">Software</a></li>
                        <li><a href="#" class="text-white-50">Esports Partners</a></li>
                        <li><a href="#" class="text-white-50">Community</a></li>
                        <li><a href="#" class="text-white-50">Blog</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-12 mb-4">
                    <h6 class="fw-bold mb-3">Newsletter</h6>
                    <p class="text-white-50 small">Subscribe to get special offers, free giveaways, and exclusive deals.</p>
                    <form class="newsletter-form" id="newsletterForm">
                        <div class="input-group">
                            <input type="email" class="form-control" placeholder="Your email" id="newsletterEmail">
                            <button class="btn btn-primary" type="submit">
                                <i class="fas fa-paper-plane"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            <hr class="mt-4 mb-3 bg-secondary">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <small class="text-white-50">© 2025 GearDTK. All rights reserved.</small>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <span class="text-white-50">
                        <i class="fab fa-cc-visa fa-lg me-2"></i>
                        <i class="fab fa-cc-mastercard fa-lg me-2"></i>
                        <i class="fab fa-cc-paypal fa-lg me-2"></i>
                        <i class="fab fa-cc-amex fa-lg"></i>
                    </span>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    <script src="~/js/cart.js"></script>

    <script>
        // Cập nhật số lượng giỏ hàng
        function updateCartCount() {
        $.get('/ShoppingCart/GetCartCount', function(data) {
        $('#cartCount').text(data.count);
        if (data.count === 0) $('#cartCount').hide();
        else $('#cartCount').show();
        });
        }

        // Cập nhật số lượng wishlist
        function updateWishlistCount() {
        $.get('/Account/GetWishlistCount', function(data) {
        $('#wishlistCount').text(data.count);
        if (data.count === 0) {
        $('#wishlistCount').hide();
        } else {
        $('#wishlistCount').show();
        }
        });
        }

        // ========== KIỂM TRA ĐƠN HÀNG MỚI (CHỈ CHO ADMIN) ==========
        function checkNewOrders() {
        $.get('/Admin/Order/GetNewOrdersCount', function(data) {
        if (data.count > 0) {
        $('#newOrderBadge').text(data.count).show();
        } else {
        $('#newOrderBadge').hide();
        }
        }).fail(function() {
        // Nếu chưa có action GetNewOrdersCount, ẩn badge
        $('#newOrderBadge').hide();
        });
        }

        $(document).ready(function() {
        updateCartCount();
        updateWishlistCount();

        // Kiểm tra đơn hàng mới nếu là Admin
        @if (User.IsInRole("Admin"))
        {
            <text>
                checkNewOrders();
                // Kiểm tra mỗi 30 giây
                setInterval(checkNewOrders, 30000);
            </text>
        }
        });

        $('#newsletterForm').submit(function(e) {
        e.preventDefault();
        var email = $('#newsletterEmail').val();
        if (email) alert('Cảm ơn ' + email + ' đã đăng ký nhận tin!');
        $('#newsletterEmail').val('');
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>