@model GearDTK.Models.Order
@{
    ViewData["Title"] = "Đặt hàng thành công - GearDTK";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="thankyou-container">
    <div class="container">
        <div class="thankyou-card">
            <div class="thankyou-icon"><i class="fas fa-check-circle"></i></div>
            <h1 class="thankyou-title">CẢM ƠN BẠN ĐÃ ĐẶT HÀNG!</h1>
            <p class="thankyou-message">Đơn hàng của bạn đã được đặt thành công. Chúng tôi sẽ xử lý và giao hàng sớm nhất có thể.</p>

            <div class="order-info-card">
                <div class="order-code"><span class="label">Mã đơn hàng:</span><strong class="value">@Model.OrderCode</strong></div>
                <div class="order-date"><span class="label">Ngày đặt:</span><span class="value">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span></div>
                <div class="order-status"><span class="label">Trạng thái:</span><span class="badge-status">Đang xử lý</span></div>
            </div>

            <div class="order-details">
                <h3>Chi tiết đơn hàng</h3>
                <div class="order-items">
                    @if (Model.OrderItems != null && Model.OrderItems.Any())
                    {
                        @foreach (var item in Model.OrderItems)
                        {
                            <div class="order-item">
                                <div class="item-image"><img src="@item.ProductImage" alt="@item.ProductName" onerror="this.src='https://placehold.co/80x80/f5f5f5/999?text=No+Image'"></div>
                                <div class="item-details"><div class="item-name">@item.ProductName</div><div class="item-price">@item.Price.ToString("N0")₫ x @item.Quantity</div></div>
                                <div class="item-total">@((item.Price * item.Quantity).ToString("N0"))₫</div>
                            </div>
                        }
                    }
                </div>
                <div class="order-totals">
                    <div class="total-row"><span>Tạm tính:</span><span>@Model.Subtotal.ToString("N0")₫</span></div>
                    <div class="total-row"><span>Phí vận chuyển:</span><span class="text-success">Miễn phí</span></div>
                    <div class="total-row grand-total"><span>Tổng cộng:</span><span>@Model.Total.ToString("N0")₫</span></div>
                </div>
            </div>

            <div class="shipping-info">
                <h3>Thông tin giao hàng</h3>
                <div class="info-row"><div class="info-label">Người nhận:</div><div class="info-value">@Model.CustomerName</div></div>
                <div class="info-row"><div class="info-label">Địa chỉ:</div><div class="info-value">@Model.Address, @Model.City, @Model.Country</div></div>
                <div class="info-row"><div class="info-label">Số điện thoại:</div><div class="info-value">@Model.Phone</div></div>
                <div class="info-row"><div class="info-label">Email:</div><div class="info-value">@Model.Email</div></div>
                @if (!string.IsNullOrEmpty(Model.OrderNote))
                {
                    <div class="info-row"><div class="info-label">Ghi chú:</div><div class="info-value">@Model.OrderNote</div></div>
                }
            </div>

            <div class="thankyou-actions">
                <a href="/" class="btn-continue">
                    <i class="fas fa-home"></i> Về trang chủ
                </a>
                <a href="/Account/OrderHistory" class="btn-shop">
                    <i class="fas fa-shopping-bag"></i> Xem đơn hàng của tôi
                </a>
                <a href="/products" class="btn-shop">
                    <i class="fas fa-shopping-bag"></i> Tiếp tục mua sắm
                </a>
            </div>

            <div class="support-info">
                <p><i class="fas fa-envelope"></i> Một email xác nhận đã được gửi đến <strong>@Model.Email</strong></p>
                <p><i class="fas fa-headset"></i> Mọi thắc mắc xin liên hệ: <strong>support@geardtk.com</strong></p>
            </div>
        </div>
    </div>
</div>

<style>
    .thankyou-container {
        background: #f5f5f5;
        min-height: 100vh;
        padding: 3rem 1rem;
    }

    .thankyou-card {
        max-width: 800px;
        margin: 0 auto;
        background: white;
        border-radius: 20px;
        padding: 2rem;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
    }

    .thankyou-icon {
        text-align: center;
        font-size: 4rem;
        color: #00a650;
        margin-bottom: 1rem;
    }

    .thankyou-title {
        text-align: center;
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 1rem;
    }

    .thankyou-message {
        text-align: center;
        color: #666;
        margin-bottom: 2rem;
    }

    .order-info-card {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 1rem;
        display: flex;
        justify-content: space-around;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 2rem;
    }

        .order-info-card .label {
            font-size: 0.8rem;
            color: #666;
        }

    .badge-status {
        background: #ffc107;
        color: #856404;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.75rem;
    }

    .order-details h3 {
        font-size: 1.2rem;
        margin-bottom: 1rem;
        border-bottom: 2px solid #e5e5e5;
        padding-bottom: 0.5rem;
    }

    .order-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 0;
        border-bottom: 1px solid #eee;
    }

    .item-image {
        width: 70px;
        height: 70px;
        background: #f8f8f8;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .item-image img {
            max-width: 80%;
            max-height: 80%;
            object-fit: contain;
        }

    .item-details {
        flex: 1;
    }

    .item-name {
        font-weight: 500;
    }

    .item-price {
        font-size: 0.8rem;
        color: #666;
    }

    .item-total {
        font-weight: 600;
    }

    .order-totals {
        margin-top: 1rem;
        text-align: right;
    }

    .total-row {
        display: flex;
        justify-content: flex-end;
        gap: 2rem;
        padding: 0.25rem 0;
    }

    .grand-total {
        font-size: 1.2rem;
        font-weight: 700;
        color: #667eea;
        border-top: 1px solid #e5e5e5;
        margin-top: 0.5rem;
        padding-top: 0.75rem;
    }

    .shipping-info {
        margin-top: 2rem;
        padding-top: 1rem;
        border-top: 1px solid #e5e5e5;
    }

    .info-row {
        display: flex;
        padding: 0.4rem 0;
    }

    .info-label {
        width: 110px;
        font-weight: 600;
        color: #666;
    }

    .thankyou-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin: 2rem 0 1.5rem;
    }

    .btn-continue, .btn-shop {
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
    }

    .btn-continue {
        background: #f0f0f0;
        color: #1a1a1a;
    }

    .btn-shop {
        background: #1a1a1a;
        color: white;
    }

    .support-info {
        text-align: center;
        font-size: 0.8rem;
        color: #999;
        padding-top: 1rem;
        border-top: 1px solid #e5e5e5;
    }

    @@media (max-width: 576px) {
        .thankyou-card {
            padding: 1.5rem;
        }

        .thankyou-title {
            font-size: 1.3rem;
        }

        .order-item {
            flex-wrap: wrap;
        }

        .thankyou-actions {
            flex-direction: column;
        }
    }
</style>