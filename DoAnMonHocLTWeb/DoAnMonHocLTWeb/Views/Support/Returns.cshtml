@{
    ViewData["Title"] = "Returns & Refunds";
}

<section class="py-5 bg-dark text-white">
    <div class="container">

        <div class="text-center mb-5">
            <h1 class="fw-bold display-5">Returns & Refunds</h1>
            <p class="text-secondary">
                Easy returns and transparent refund policies.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="card h-100 bg-black border-secondary text-white">
                    <div class="card-body text-center">
                        <i class="fas fa-box-open fa-3x mb-3"></i>
                        <h5>7-Day Return</h5>
                        <p class="text-secondary">
                            Return eligible items within 7 days after delivery.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 bg-black border-secondary text-white">
                    <div class="card-body text-center">
                        <i class="fas fa-undo-alt fa-3x mb-3"></i>
                        <h5>Simple Process</h5>
                        <p class="text-secondary">
                            Submit a return request and our team will assist you.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 bg-black border-secondary text-white">
                    <div class="card-body text-center">
                        <i class="fas fa-money-bill-wave fa-3x mb-3"></i>
                        <h5>Fast Refunds</h5>
                        <p class="text-secondary">
                            Approved refunds are processed within 3–5 business days.
                        </p>
                    </div>
                </div>
            </div>

        </div>

        <div class="card bg-black border-secondary mt-5">
            <div class="card-body">

                <h3 class="mb-4">Return Conditions</h3>

                <ul class="list-group list-group-flush">
                    <li class="list-group-item bg-black text-white border-secondary">
                        Product must be in original condition.
                    </li>

                    <li class="list-group-item bg-black text-white border-secondary">
                        Original packaging and accessories must be included.
                    </li>

                    <li class="list-group-item bg-black text-white border-secondary">
                        Physical damage caused by misuse is not eligible.
                    </li>

                    <li class="list-group-item bg-black text-white border-secondary">
                        Proof of purchase is required.
                    </li>
                </ul>

            </div>
        </div>

    </div>
</section>